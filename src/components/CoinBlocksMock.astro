---
/*
 * A wallet's coin inventory, ported from the app's UtxosInventoryPanel and its
 * glass blocks (ui-tauri/src/components/kb/wallets/: UtxosInventoryPanel.tsx,
 * utxo3d/). App dark-theme values are copied literally.
 *
 * The eye is the app's "Hide sensitive data": values blur, and the blocks stop
 * reading amounts at all, levelling out and re-sorting by outpoint. Here the
 * blocks ease between the two arrangements instead of being rebuilt, and the
 * switch flips on its own until someone touches the panel.
 *
 * three.js loads only as the panel nears, sharing the graph's chunk. Before
 * that, and wherever WebGL is missing, the same blocks show straight on as SVG.
 */
import { COINS, PENDING, TOTAL_SATS, WALLET, btc, coinBlocks, coinFrame } from "../lib/coins/coins";

const FRONT = {
  shown: coinFrame(coinBlocks(COINS, false)),
  hidden: coinFrame(coinBlocks(COINS, true)),
};

const ROWS = [...COINS].sort((a, b) => b.sats - a.sats);
const status = (confirmations: number) => (confirmations ? `${confirmations.toLocaleString("en-US")} conf` : "mempool");

const TIPS = Object.fromEntries(
  COINS.map((coin) => [coin.outpoint, { title: coin.outpoint, amount: btc(coin.sats), parts: [coin.location, status(coin.confirmations)] }]),
);
---

<div class="coin-mock" data-coin-mock data-hidden="false" data-tips={JSON.stringify(TIPS)}>
  <div class="coin-head">
    <div class="coin-title">
      <span class="coin-title-icon" aria-hidden="true">
        <!-- lucide coins -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6" /><path d="M18.09 10.37A6 6 0 1 1 10.34 18" /><path d="M7 6h1v4" /><path d="m16.71 13.88.7.71-2.82 2.82" /></svg>
      </span>
      <span class="coin-title-copy">
        <b>UTXOs</b>
        <span>{WALLET} · {COINS.length} active outputs · {PENDING} pending</span>
      </span>
    </div>
    <button class="coin-eye" type="button" data-coin-eye aria-pressed="false">
      <svg class="coin-eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
      <svg class="coin-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" /><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" /><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" /><path d="m2 2 20 20" /></svg>
      <span class="coin-eye-label" data-label-show="Show amounts" data-label-hide="Hide amounts">Hide amounts</span>
    </button>
  </div>

  <div
    class="coin-stage"
    data-coin-stage
    role="img"
    tabindex="0"
    aria-label={`${COINS.length} unspent coins as glass blocks, taller for larger amounts. Drag, or use the arrow keys, to turn them; Home resets the view.`}
  >
    {(["shown", "hidden"] as const).map((mode) => (
      <svg class="coin-front" data-front={mode} viewBox={FRONT[mode].viewBox} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        {FRONT[mode].rects.map((rect) => (
          <rect
            class:list={["cf-block", rect.frosted ? "cf-frosted" : "cf-clear"]}
            data-leg-id={rect.id}
            x={rect.x}
            y={rect.y}
            width={rect.width}
            height={rect.height}
            rx={Math.min(0.05, rect.height / 2.5)}
          />
        ))}
      </svg>
    ))}
    <div class="coin-tip" data-coin-tip aria-hidden="true" hidden>
      <div class="coin-tip-title" data-tip-title></div>
      <div class="coin-tip-meta" data-tip-meta></div>
    </div>
    <span class="coin-hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" /></svg>
      Drag to turn
    </span>
  </div>

  <p class="coin-legend" data-legend="shown">Each block is one unspent coin, as tall as its amount relative to this wallet's largest. Frosted: not yet confirmed.</p>
  <p class="coin-legend" data-legend="hidden">Each block is one unspent coin. Values are hidden, so every block has the same height. Frosted: not yet confirmed.</p>

  <div class="coin-table-wrap">
    <table class="coin-table">
      <thead>
        <tr>
          <th>Amount</th>
          <th>Location</th>
          <th>Confirmed</th>
          <th>Status</th>
          <th>Outpoint</th>
        </tr>
      </thead>
      <tbody>
        {ROWS.map((coin) => (
          <tr data-leg-id={coin.outpoint}>
            <td class="coin-amount"><span class="coin-sensitive">{btc(coin.sats)}</span></td>
            <td>{coin.location}</td>
            <td class="coin-muted">{coin.when}</td>
            <td>
              <span class:list={["coin-status", { "is-pending": !coin.confirmed }]}>{status(coin.confirmations)}</span>
            </td>
            <td class="coin-outpoint">{coin.outpoint}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="coin-total">
    <span>Total</span>
    <span class="coin-sensitive">{btc(TOTAL_SATS)}</span>
  </div>
</div>

<script>
  import { COINS, coinBlocks, type CoinBlock } from "../lib/coins/coins";
  import type { CoinScene } from "../lib/coins/coinScene";

  type View = { yaw: number; pitch: number };
  type Tip = { title: string; amount: string; parts: string[] };

  // The glass view's rest pose and limits, as in the graph above.
  const REST: View = { yaw: 0.5, pitch: 0.3 };
  const FRONT: View = { yaw: 0, pitch: 0 };
  const YAW_LIMIT = 0.95;
  const PITCH_LIMIT = 0.6;
  const DRAG = 0.008;
  const KEY_STEP = 0.08;
  const TURN_MS = 1500;
  const MORPH_MS = 1300;
  const CYCLE_MS = 5200;

  const clamp = (value: number, limit: number) => Math.min(limit, Math.max(-limit, value));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

  function webglAvailable() {
    try {
      const context = document.createElement("canvas").getContext("webgl2");
      context?.getExtension("WEBGL_lose_context")?.loseContext();
      return Boolean(context);
    } catch {
      return false;
    }
  }

  for (const mock of document.querySelectorAll<HTMLElement>("[data-coin-mock]")) {
    const stage = mock.querySelector<HTMLElement>("[data-coin-stage]");
    const eye = mock.querySelector<HTMLButtonElement>("[data-coin-eye]");
    if (!stage || !eye) continue;
    const calm = matchMedia("(prefers-reduced-motion: reduce)");
    const tips = JSON.parse(mock.dataset.tips ?? "{}") as Record<string, Tip>;

    let scene: CoinScene | null = null;
    let loading: Promise<CoinScene | null> | null = null;
    let glass = false;
    let failed = false;
    let view: View = { ...FRONT };
    let raf = 0;
    let turning = 0;
    let turnTimer = 0;
    let morphing = 0;
    let onScreen = false;
    let cycling = !calm.matches;
    let cycleTimer = 0;
    let current: CoinBlock[] = coinBlocks(COINS, false);

    const hidden = () => mock.dataset.hidden === "true";

    const draw = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        scene?.render();
      });
    };

    const applyView = () => {
      scene?.setView(view.yaw, view.pitch);
      draw();
    };

    const fail = () => {
      failed = true;
      glass = false;
      window.clearTimeout(turnTimer);
      cancelAnimationFrame(turning);
      cancelAnimationFrame(morphing);
      stage.classList.remove("is-glass");
      scene?.dispose();
      scene = null;
      stage.querySelector("canvas")?.remove();
    };

    const build = () =>
      (loading ??= import("../lib/coins/coinScene")
        .then(({ createCoinScene }) => {
          if (failed) return null;
          const canvas = document.createElement("canvas");
          canvas.className = "coin-canvas";
          canvas.setAttribute("aria-hidden", "true");
          canvas.addEventListener("webglcontextlost", fail);
          stage.prepend(canvas);
          // Always built from the shown values, so the frame is the one the
          // straight-on SVG uses; a hidden switch then moves blocks inside it.
          const created = createCoinScene(canvas, coinBlocks(COINS, false), getComputedStyle(stage).backgroundColor);
          if (hidden()) created.place(current);
          created.resize(stage.clientWidth, stage.clientHeight);
          created.setView(view.yaw, view.pitch);
          scene = created;
          return created;
        })
        .catch(() => {
          fail();
          return null;
        }));

    const turnTo = (target: View, ms: number) => {
      cancelAnimationFrame(turning);
      const from = { ...view };
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        const k = ease(t);
        view = { yaw: from.yaw + (target.yaw - from.yaw) * k, pitch: from.pitch + (target.pitch - from.pitch) * k };
        applyView();
        if (t < 1) turning = requestAnimationFrame(step);
      };
      turning = requestAnimationFrame(step);
    };

    // ── Hide amounts ────────────────────────────────────────
    // The blocks ease from one arrangement to the other: heights level out (or
    // grow back) while each coin slides to its new slot.
    const morphTo = (target: CoinBlock[]) => {
      cancelAnimationFrame(morphing);
      if (!scene || calm.matches) {
        current = target;
        scene?.place(current);
        applyView();
        return;
      }
      const from = new Map(current.map((block) => [block.id, block]));
      // Two beats instead of one blur of motion: hiding levels the heights
      // first and then re-sorts; showing re-sorts first and then grows. Blocks
      // moving right pass in front, those moving left behind, so the shuffle
      // never runs one coin through another.
      const levelling = target.every((block) => block.height === target[0].height);
      const phase = (t: number, a: number, b: number) => ease(Math.min(1, Math.max(0, (t - a) / (b - a))));
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / MORPH_MS);
        const kh = levelling ? phase(t, 0, 0.55) : phase(t, 0.45, 1);
        const kx = levelling ? phase(t, 0.4, 1) : phase(t, 0, 0.6);
        current = target.map((to) => {
          const was = from.get(to.id) ?? to;
          const height = was.height + (to.height - was.height) * kh;
          const lift = Math.sin(Math.PI * kx) * Math.sign(to.x - was.x) * 0.55;
          return { ...to, x: was.x + (to.x - was.x) * kx, z: lift, height, y: height / 2 };
        });
        scene?.place(current);
        applyView();
        if (t < 1) morphing = requestAnimationFrame(step);
      };
      morphing = requestAnimationFrame(step);
    };

    const setHidden = (next: boolean) => {
      hover(null);
      mock.dataset.hidden = String(next);
      eye.setAttribute("aria-pressed", String(next));
      const label = eye.querySelector<HTMLElement>(".coin-eye-label");
      if (label) label.textContent = (next ? label.dataset.labelShow : label.dataset.labelHide) ?? "";
      morphTo(coinBlocks(COINS, next));
    };

    // Flips on its own until someone touches the panel, so the levelling is
    // seen without hunting for the switch.
    const stopCycle = () => {
      cycling = false;
      window.clearTimeout(cycleTimer);
    };
    const startCycle = (delay: number) => {
      if (!cycling || cycleTimer) return;
      const next = () => {
        if (!cycling) return;
        if (onScreen && !document.hidden) setHidden(!hidden());
        cycleTimer = window.setTimeout(next, CYCLE_MS);
      };
      cycleTimer = window.setTimeout(next, delay);
    };

    eye.addEventListener("click", () => {
      stopCycle();
      setHidden(!hidden());
    });

    // ── Hover ───────────────────────────────────────────────
    const tip = mock.querySelector<HTMLElement>("[data-coin-tip]");
    const tipTitle = mock.querySelector<HTMLElement>("[data-tip-title]");
    const tipMeta = mock.querySelector<HTMLElement>("[data-tip-meta]");
    let hovered: string | null = null;

    function hover(id: string | null) {
      if (id === hovered) return;
      hovered = id;
      scene?.highlight(id);
      draw();
      for (const el of mock.querySelectorAll<HTMLElement | SVGElement>("[data-leg-id]")) {
        el.classList.toggle("is-hot", el.dataset.legId === id);
      }
      const info = id ? tips[id] : undefined;
      if (!tip || !tipTitle || !tipMeta) return;
      tip.hidden = !info;
      if (!info) return;
      tipTitle.textContent = info.title;
      const parts = [hidden() ? "Hidden" : info.amount, ...info.parts].map((text) =>
        Object.assign(document.createElement("span"), { textContent: text }),
      );
      tipMeta.replaceChildren(...parts);
    }

    // ── Turning ─────────────────────────────────────────────
    const takeOver = () => {
      stopCycle();
      window.clearTimeout(turnTimer);
      cancelAnimationFrame(turning);
      stage.classList.add("is-handled");
    };

    const turn = (yaw: number, pitch: number) => {
      view = { yaw: clamp(yaw, YAW_LIMIT), pitch: clamp(pitch, PITCH_LIMIT) };
      applyView();
    };

    let drag: { x: number; y: number; view: View; touch: boolean; active: boolean } | null = null;
    stage.addEventListener("pointerdown", (event) => {
      if (!glass) return;
      drag = { x: event.clientX, y: event.clientY, view: { ...view }, touch: event.pointerType === "touch", active: false };
    });
    stage.addEventListener("pointermove", (event) => {
      if (!drag?.active && event.pointerType !== "touch") {
        if (glass && scene) {
          const rect = stage.getBoundingClientRect();
          hover(scene.pick(((event.clientX - rect.left) / rect.width) * 2 - 1, 1 - ((event.clientY - rect.top) / rect.height) * 2));
        } else {
          hover((event.target as Element).closest<SVGElement>("[data-leg-id]")?.dataset.legId ?? null);
        }
      }
      if (!drag) return;
      if (!drag.active) {
        // Only a sideways move turns the piece, so a scroll that starts here
        // leaves the guided turn alone.
        if (Math.abs(event.clientX - drag.x) < 4 && (drag.touch || Math.abs(event.clientY - drag.y) < 4)) return;
        takeOver();
        hover(null);
        stage.setPointerCapture(event.pointerId);
        drag = { ...drag, view: { ...view }, active: true };
      }
      turn(
        drag.view.yaw + (event.clientX - drag.x) * DRAG,
        drag.touch ? drag.view.pitch : drag.view.pitch + (event.clientY - drag.y) * DRAG,
      );
    });
    const release = () => {
      drag = null;
    };
    stage.addEventListener("pointerup", release);
    stage.addEventListener("pointercancel", release);
    stage.addEventListener("pointerleave", () => {
      if (!drag?.active) hover(null);
    });
    stage.addEventListener("dblclick", () => {
      if (!glass) return;
      takeOver();
      turnTo(REST, 500);
    });
    stage.addEventListener("keydown", (event) => {
      if (!glass) return;
      const moves: Record<string, [number, number]> = {
        ArrowLeft: [-KEY_STEP, 0],
        ArrowRight: [KEY_STEP, 0],
        ArrowUp: [0, -KEY_STEP],
        ArrowDown: [0, KEY_STEP],
      };
      if (event.key === "Home") {
        event.preventDefault();
        takeOver();
        turn(REST.yaw, REST.pitch);
        return;
      }
      const move = moves[event.key];
      if (!move) return;
      event.preventDefault();
      takeOver();
      turn(view.yaw + move[0], view.pitch + move[1]);
    });

    for (const row of mock.querySelectorAll<HTMLElement>("tr[data-leg-id]")) {
      row.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "touch") hover(row.dataset.legId ?? null);
      });
      row.addEventListener("pointerleave", () => hover(null));
    }

    // ── Lifecycle ───────────────────────────────────────────
    const reveal = async () => {
      const created = await build();
      if (glass) return;
      if (!created) {
        startCycle(CYCLE_MS);
        return;
      }
      created.render();
      glass = true;
      stage.classList.add("is-glass");
      if (calm.matches) {
        view = { ...REST };
        applyView();
      } else {
        turnTimer = window.setTimeout(() => turnTo(REST, TURN_MS), 380);
      }
      startCycle(380 + TURN_MS + 1800);
    };

    new ResizeObserver(() => {
      scene?.resize(stage.clientWidth, stage.clientHeight);
      draw();
    }).observe(stage);

    const canGlass = webglAvailable();
    if (canGlass) {
      const near = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          near.disconnect();
          void build();
        },
        { rootMargin: "600px 0px" },
      );
      near.observe(stage);
    }

    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        if (!onScreen) return;
        if (canGlass && !glass && !failed) void reveal();
        else if (!canGlass) startCycle(CYCLE_MS);
      },
      { threshold: 0.45 },
    ).observe(stage);
  }
</script>

<style>
  /* App dark-theme values copied literally: kb-surface on --card, --muted
     oklch(0.269 0 0), --muted-foreground oklch(0.708 0 0). */
  .coin-mock {
    --co-card: #0f0f11;
    --co-line: rgb(255 255 255 / 0.1);
    --co-muted-fg: #a1a1a1;

    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--co-card);
    box-shadow: 0 24px 56px -28px rgb(0 0 0 / 0.75);
    overflow: hidden;
  }

  .coin-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--co-line);
  }

  .coin-title {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .coin-title-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--co-line);
    border-radius: 7px;
    background: #0a0a0a;
    color: var(--co-muted-fg);
  }

  .coin-title-icon svg {
    width: 16px;
    height: 16px;
  }

  .coin-title-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .coin-title-copy b {
    font-size: 13.5px;
    font-weight: 500;
  }

  .coin-title-copy span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11.5px;
    color: var(--co-muted-fg);
  }

  /* The title bar's eye, given a label: on a page it has to say what it does. */
  .coin-eye {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 12px;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 7px;
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--fg);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .coin-eye:hover {
    background: rgb(255 255 255 / 0.08);
  }

  .coin-eye svg {
    width: 15px;
    height: 15px;
    color: var(--co-muted-fg);
  }

  .coin-eye-off,
  [data-hidden="true"] .coin-eye-on {
    display: none;
  }

  [data-hidden="true"] .coin-eye-off {
    display: block;
  }

  [data-hidden="true"] .coin-eye {
    border-color: rgb(255 51 65 / 0.35);
    background: rgb(255 51 65 / 0.1);
  }

  /* ── Stage ────────────────────────────────────────────── */
  /* Wide and low, as the app's 220 px strip: a shelf of coins is long. */
  .coin-stage {
    position: relative;
    aspect-ratio: 3.3 / 1;
    overflow: hidden;
    background: var(--co-card);
    outline: none;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .coin-stage:focus-visible {
    box-shadow: inset 0 0 0 2px rgb(250 250 250 / 0.55);
  }

  .coin-stage.is-glass {
    cursor: grab;
  }

  .coin-stage.is-glass:active {
    cursor: grabbing;
  }

  .coin-front,
  .coin-stage :global(.coin-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    transition: opacity 0.35s ease;
  }

  .coin-front {
    opacity: 0;
    pointer-events: none;
  }

  [data-hidden="false"] .coin-front[data-front="shown"],
  [data-hidden="true"] .coin-front[data-front="hidden"] {
    opacity: 1;
    pointer-events: auto;
  }

  [data-hidden] .coin-stage.is-glass .coin-front {
    opacity: 0;
    pointer-events: none;
  }

  .coin-stage :global(.coin-canvas) {
    opacity: 0;
  }

  .coin-stage.is-glass :global(.coin-canvas) {
    opacity: 1;
  }

  .cf-clear { fill: #2563eb; }
  .cf-frosted { fill: #a3aebd; fill-opacity: 0.45; }
  .cf-block { transition: filter 0.15s ease; }
  .cf-block.is-hot { filter: brightness(1.35); }

  .coin-tip {
    position: absolute;
    left: 12px;
    top: 10px;
    z-index: 2;
    max-width: min(420px, calc(100% - 24px));
    padding: 8px 12px;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 6px;
    background: rgb(16 17 20 / 0.95);
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.3);
    font-size: 12px;
    color: #fff;
    pointer-events: none;
  }

  .coin-tip[hidden] {
    display: none;
  }

  .coin-tip-title {
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .coin-tip-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 8px;
    margin-top: 4px;
    color: rgb(255 255 255 / 0.7);
  }

  .coin-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 9px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--fg-dim);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(15 15 17 / 0.8);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .coin-hint svg {
    width: 11px;
    height: 11px;
  }

  .coin-stage.is-glass .coin-hint {
    opacity: 1;
    transition-delay: 1.6s;
  }

  .coin-stage.is-handled .coin-hint {
    opacity: 0;
    transition-delay: 0s;
