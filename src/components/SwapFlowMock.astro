---
/*
 * Interactive mock of Kassiber's swap detail: the paired swap route with its
 * leg toggle, and the transaction graph in glass underneath, ported from the
 * app's TransactionGraphPanel (ui-tauri/src/components/transactions/
 * TransactionGraphTab.tsx) and its 3D view (graph3d/). App dark-theme values
 * are copied literally, so the panel reads as the app.
 *
 * The graph is the app's own scene: one glass ribbon per input and output, as
 * thick as mempool draws that strand, your coins as blue blocks, everyone
 * else's grey, confidential amounts frosted, and every ribbon meeting in one
 * glass collar. three.js loads only once the panel scrolls near; until then,
 * and wherever WebGL is missing, the same piece shows straight on as SVG.
 */
import { SWAP_LEGS, formatBtc, type IoRow, type SwapLeg } from "../lib/txgraph/demoSwap";
import { frontView } from "../lib/txgraph/frontView";
import { ribbonLayout } from "../lib/txgraph/ribbonLayout";

const LEGS: SwapLeg[] = [SWAP_LEGS.liquid, SWAP_LEGS.bitcoin];
const FRONT = Object.fromEntries(LEGS.map((leg) => [leg.key, frontView(ribbonLayout(leg.graph))]));

/** Rows shown before "Show all", fewer than the app's eight to keep the panel short. */
const COLLAPSED_ROWS = 3;

const total = (rows: IoRow[]) => {
  const known = rows.filter((row) => row.sats !== null);
  if (!known.length) return { label: "Known total", value: "Confidential amount" };
  return {
    label: known.length === rows.length ? "Total" : "Known total",
    value: formatBtc(known.reduce((sum, row) => sum + (row.sats ?? 0), 0)),
  };
};

const LEGEND = [
  { key: "known", label: "Known amount" },
  { key: "unknown", label: "Amount unknown" },
  { key: "own", label: "Your wallet" },
  { key: "other", label: "Other" },
  { key: "fee", label: "Fee" },
];
---

<div class="swap-mock" data-swap-mock data-leg="liquid">
  <div class="swap-route" role="group" aria-label="Paired swap route">
    <div class="swap-route-head">
      <svg class="swap-route-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3 4 7l4 4" /><path d="M4 7h16" /><path d="m16 21 4-4-4-4" /><path d="M20 17H4" /></svg>
      <span>Paired swap route</span>
    </div>

    <div class="swap-route-grid">
      <button class="swap-leg" type="button" data-leg-btn="liquid" aria-pressed="true">
        <span class="swap-leg-top">
          <span class="swap-leg-key">Consolidation leg</span>
          <span class="swap-leg-chip">Selected</span>
        </span>
        <span class="swap-leg-asset">Liquid <img src="/harnesses/liquid.svg" alt="" /></span>
        <span class="swap-leg-amt">{formatBtc(4_200_000)}</span>
      </button>

      <div class="swap-peg">
        <svg class="swap-peg-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        <span class="swap-peg-copy">
          <span class="swap-peg-name">Atomic Swap</span>
          <span class="swap-peg-policy">Carrying value</span>
          <span class="swap-peg-fee">Fee 0.10%</span>
        </span>
        <svg class="swap-peg-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </div>

      <button class="swap-leg" type="button" data-leg-btn="bitcoin" aria-pressed="false">
        <span class="swap-leg-top">
          <span class="swap-leg-key">Received leg</span>
          <span class="swap-leg-chip">Selected</span>
        </span>
        <span class="swap-leg-asset">Bitcoin <img src="/harnesses/bitcoin.svg" alt="" /></span>
        <span class="swap-leg-amt">{formatBtc(4_195_800)}</span>
      </button>
    </div>
  </div>

  <div class="swap-graph-head">
    <div class="swap-graph-copy">
      <div class="swap-graph-title">Transaction graph</div>
      <!-- A complete graph carries no caption in the app; only the confidential
           Liquid leg explains itself. -->
      <div class="swap-graph-sub" data-for="liquid">Reference graph: public references are available; confidential amounts stay hidden</div>
    </div>
    <span class="swap-badge">Booked custody conversion</span>
  </div>

  <div
    class="swap-stage"
    data-swap-stage
    role="img"
    tabindex="0"
    aria-label="3D view of the transaction flow. Drag, or use the arrow keys, to turn it; Home resets the view."
  >
    {LEGS.map((leg) => {
      const view = FRONT[leg.key];
      return (
        <svg class="swap-front" data-for={leg.key} viewBox={view.viewBox} preserveAspectRatio="xMidYMid meet" aria-hidden="true">
          {view.ribbons.map((ribbon) => <path class={`sf-ribbon sf-${ribbon.kind}`} d={ribbon.d} />)}
          <rect class="sf-collar" x={view.collar.x} y={view.collar.y} width={view.collar.width} height={view.collar.height} rx={view.collar.width / 2} />
          {view.blocks.map((block) => (
            <rect
              class:list={["sf-block", block.owned ? "sf-own" : "sf-other"]}
              x={block.x}
              y={block.y}
              width={block.width}
              height={block.height}
              rx={Math.min(0.05, block.height / 2.5)}
            />
          ))}
        </svg>
      );
    })}
    <span class="swap-hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" /></svg>
      Drag to turn
    </span>
  </div>

  <div class="swap-legend">
    {LEGEND.map((item) => (
      <span class="swap-legend-item">
        <span class={`swap-swatch swap-swatch--${item.key}`} aria-hidden="true"></span>
        {item.label}
      </span>
    ))}
  </div>
  <p class="swap-note">
    All inputs are spent together in the glass ring; the order of the ribbons
    does not say which input paid which output.
  </p>

  <!-- Both legs' lists share one grid cell, so the panel keeps the taller one's
       height and the page below never jumps when the legs take turns. -->
  <div class="swap-io-stack">
  {LEGS.map((leg) => (
    <section class="swap-io" data-for={leg.key} data-io aria-label="Inputs and outputs">
      <div class="swap-io-cols">
        {([["Inputs", leg.inputs, "input"], ["Outputs", leg.outputs, "output"]] as const).map(([title, rows, side]) => (
          <div class="swap-io-col">
            <div class="swap-io-head">
              <span>{title}</span>
              <span>{rows.length}</span>
            </div>
            {rows.map((row, index) => (
              <div class:list={["swap-io-row", { "is-extra": index >= COLLAPSED_ROWS }]}>
                <span class:list={["swap-io-mark", `swap-io-mark--${side}`]} aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
                </span>
                <span class="swap-io-body">
                  <span class="swap-io-ref">{row.ref}</span>
                  <span class="swap-io-meta">{row.meta.map((part) => <span>{part}</span>)}</span>
                </span>
                <span class="swap-io-amt">{row.sats === null ? "Confidential amount" : formatBtc(row.sats)}</span>
              </div>
            ))}
            {rows.length > COLLAPSED_ROWS && (
              <button class="swap-io-more" type="button" data-io-more aria-expanded="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                <span data-more-label={`Show all ${rows.length - COLLAPSED_ROWS} more`}>Show all {rows.length - COLLAPSED_ROWS} more</span>
              </button>
            )}
          </div>
        ))}
      </div>
      <div class="swap-io-totals">
        {[leg.inputs, leg.outputs].map((rows) => {
          const sum = total(rows);
          return (
            <div class="swap-io-total">
              <span>{sum.label}</span>
              <span>{sum.value}</span>
            </div>
          );
        })}
      </div>
    </section>
  ))}
  </div>
</div>

<script>
  import { SWAP_LEGS } from "../lib/txgraph/demoSwap";
  import { ribbonLayout } from "../lib/txgraph/ribbonLayout";
  import type { GlassScene } from "../lib/txgraph/glassScene";

  type LegKey = "liquid" | "bitcoin";
  type View = { yaw: number; pitch: number };

  // The app's rest view, seen from the upper left so block tops and inner faces
  // show, and its turning limits (kb/glass3d/Glass3DView.tsx).
  const REST: View = { yaw: 0.5, pitch: 0.3 };
  // Where the canvas takes over from the SVG: straight on, so the hand-over is
  // invisible and the piece then turns into the rest view.
  const FRONT: View = { yaw: 0, pitch: 0 };
  const YAW_LIMIT = 0.95;
  const PITCH_LIMIT = 0.6;
  const DRAG_RADIANS_PER_PIXEL = 0.008;
  const KEY_STEP = 0.08;
  const INTRO_MS = 1500;
  const CYCLE_MS = 6500;

  const clamp = (value: number, limit: number) => Math.min(limit, Math.max(-limit, value));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);

  function webglAvailable() {
    try {
      const context = document.createElement("canvas").getContext("webgl2");
      // Contexts are few; give the probe's back at once instead of waiting for GC.
      context?.getExtension("WEBGL_lose_context")?.loseContext();
      return Boolean(context);
    } catch {
      return false;
    }
  }

  for (const mock of document.querySelectorAll<HTMLElement>("[data-swap-mock]")) {
    const stage = mock.querySelector<HTMLElement>("[data-swap-stage]");
    if (!stage) continue;
    const buttons = [...mock.querySelectorAll<HTMLButtonElement>("[data-leg-btn]")];
    const calm = matchMedia("(prefers-reduced-motion: reduce)");

    let view: View = { ...FRONT };
    let glass = false;
    let failed = false;
    let raf = 0;
    let intro = 0;
    let introTimer = 0;
    let onScreen = false;
    let cycling = !calm.matches;
    let cycleStarted = false;
    let sceneModule: Promise<typeof import("../lib/txgraph/glassScene")> | null = null;
    const scenes = new Map<LegKey, GlassScene>();
    const pending = new Map<LegKey, Promise<GlassScene | null>>();

    const activeLeg = (): LegKey => (mock.dataset.leg === "bitcoin" ? "bitcoin" : "liquid");

    const draw = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        scenes.get(activeLeg())?.render();
      });
    };

    const applyView = () => {
      for (const scene of scenes.values()) scene.setView(view.yaw, view.pitch);
      draw();
    };

    // No restore: a lost context ends the glass view and the SVG takes over.
    const fail = () => {
      failed = true;
      glass = false;
      window.clearTimeout(introTimer);
      cancelAnimationFrame(intro);
      stage.classList.remove("is-glass");
      for (const scene of scenes.values()) scene.dispose();
      scenes.clear();
      stage.querySelectorAll("canvas").forEach((canvas) => canvas.remove());
    };

    const build = (leg: LegKey) => {
      const existing = pending.get(leg);
      if (existing) return existing;
      const promise = (sceneModule ??= import("../lib/txgraph/glassScene"))
        .then(({ createGlassScene }) => {
          if (failed) return null;
          const canvas = document.createElement("canvas");
          canvas.className = "swap-canvas";
          canvas.dataset.for = leg;
          canvas.setAttribute("aria-hidden", "true");
          canvas.addEventListener("webglcontextlost", fail);
          stage.prepend(canvas);
          // Opaque, in the panel's own colour: transmission refracts what is
          // behind the glass.
          const background = getComputedStyle(stage).backgroundColor;
          const scene = createGlassScene(canvas, ribbonLayout(SWAP_LEGS[leg].graph), background);
          scene.resize(stage.clientWidth, stage.clientHeight);
          scene.setView(view.yaw, view.pitch);
          scenes.set(leg, scene);
          return scene;
        })
        .catch(() => {
          fail();
          return null;
        });
      pending.set(leg, promise);
      return promise;
    };

    const turnTo = (target: View, ms: number) => {
      cancelAnimationFrame(intro);
      const from = { ...view };
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / ms);
        const k = ease(t);
        view = {
          yaw: from.yaw + (target.yaw - from.yaw) * k,
          pitch: from.pitch + (target.pitch - from.pitch) * k,
        };
        applyView();
        if (t < 1) intro = requestAnimationFrame(step);
      };
      intro = requestAnimationFrame(step);
    };

    // The legs take turns until someone picks one, so both halves of the pair
    // get seen. The first switch waits for the piece to finish turning in.
    const startCycle = (delay: number) => {
      if (cycleStarted) return;
      cycleStarted = true;
      const next = () => {
        if (!cycling) return;
        if (onScreen && !document.hidden) select(activeLeg() === "liquid" ? "bitcoin" : "liquid");
        window.setTimeout(next, CYCLE_MS);
      };
      window.setTimeout(next, delay);
    };

    // The glass view starts straight on, under the SVG, then fades in and
    // turns into the rest view.
    const reveal = async () => {
      const scene = await build(activeLeg());
      if (glass) return;
      // three.js failed to load or draw: the straight-on pictures stay, and
      // still take turns.
      if (!scene) {
        startCycle(CYCLE_MS);
        return;
      }
      scene.render();
      glass = true;
      stage.classList.add("is-glass");
      if (calm.matches) {
        view = { ...REST };
        applyView();
      } else {
        introTimer = window.setTimeout(() => turnTo(REST, INTRO_MS), 380);
      }
      startCycle(380 + INTRO_MS + CYCLE_MS);
      // Warm the other leg so the first switch does not stall on building it.
      const other: LegKey = activeLeg() === "liquid" ? "bitcoin" : "liquid";
      const idle = window.requestIdleCallback ?? ((fn: () => void) => window.setTimeout(fn, 600));
      idle(() => void build(other));
    };

    const select = (leg: LegKey) => {
      mock.dataset.leg = leg;
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset.legBtn === leg));
      }
      if (!glass) return;
      void build(leg).then((scene) => {
        if (!scene) return;
        scene.resize(stage.clientWidth, stage.clientHeight);
        scene.setView(view.yaw, view.pitch);
        draw();
      });
    };

    // Turning the piece by hand ends the guided turn and the cycle for good.
    const takeOver = () => {
      cycling = false;
      window.clearTimeout(introTimer);
      cancelAnimationFrame(intro);
      stage.classList.add("is-handled");
    };

    // Picking a leg only ends the cycle; the piece still turns into view.
    for (const button of buttons) {
      button.addEventListener("click", () => {
        cycling = false;
        select(button.dataset.legBtn === "bitcoin" ? "bitcoin" : "liquid");
      });
    }

    // ── Turning ─────────────────────────────────────────────
    const turn = (yaw: number, pitch: number) => {
      view = { yaw: clamp(yaw, YAW_LIMIT), pitch: clamp(pitch, PITCH_LIMIT) };
      applyView();
    };

    // A press only becomes a turn once it moves sideways, so a page scroll that
    // happens to start on the piece leaves the guided turn alone.
    let drag: { x: number; y: number; view: View; touch: boolean; turning: boolean } | null = null;
    stage.addEventListener("pointerdown", (event) => {
      if (!glass) return;
      drag = { x: event.clientX, y: event.clientY, view: { ...view }, touch: event.pointerType === "touch", turning: false };
    });
    stage.addEventListener("pointermove", (event) => {
      if (!drag) return;
      if (!drag.turning) {
        if (Math.abs(event.clientX - drag.x) < 4 && (drag.touch || Math.abs(event.clientY - drag.y) < 4)) return;
        takeOver();
        stage.setPointerCapture(event.pointerId);
        drag = { ...drag, view: { ...view }, turning: true };
      }
      // A finger only turns the piece sideways; vertical swipes stay page scroll.
      turn(
        drag.view.yaw + (event.clientX - drag.x) * DRAG_RADIANS_PER_PIXEL,
        drag.touch ? drag.view.pitch : drag.view.pitch + (event.clientY - drag.y) * DRAG_RADIANS_PER_PIXEL,
      );
    });
    const release = () => {
      drag = null;
    };
    stage.addEventListener("pointerup", release);
    stage.addEventListener("pointercancel", release);
    stage.addEventListener("dblclick", () => {
      if (!glass) return;
      takeOver();
      turnTo(REST, 500);
    });
    stage.addEventListener("keydown", (event) => {
      if (!glass) return;
      const moves: Record<string, [number, number]> = {
        ArrowLeft: [-KEY_STEP, 0],
        ArrowRight: [KEY_STEP, 0],
        ArrowUp: [0, -KEY_STEP],
        ArrowDown: [0, KEY_STEP],
      };
      if (event.key === "Home") {
        event.preventDefault();
        takeOver();
        turn(REST.yaw, REST.pitch);
        return;
      }
      const move = moves[event.key];
      if (!move) return;
      event.preventDefault();
      takeOver();
      turn(view.yaw + move[0], view.pitch + move[1]);
    });

    // ── Lifecycle ───────────────────────────────────────────
    new ResizeObserver(() => {
      for (const scene of scenes.values()) scene.resize(stage.clientWidth, stage.clientHeight);
      draw();
    }).observe(stage);

    const canGlass = webglAvailable();
    if (canGlass) {
      // Fetch three.js a little ahead of the panel, and turn the piece only
      // once most of it is in view.
      const near = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          near.disconnect();
          void build(activeLeg());
        },
        { rootMargin: "600px 0px" },
      );
      near.observe(stage);
    }

    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        if (!onScreen) return;
        if (canGlass && !glass && !failed) void reveal();
        // Without WebGL the straight-on pictures take turns from the start.
        else if (!canGlass) startCycle(CYCLE_MS);
      },
      { threshold: 0.45 },
    ).observe(stage);

    // ── Inputs and outputs ──────────────────────────────────
    for (const more of mock.querySelectorAll<HTMLButtonElement>("[data-io-more]")) {
      more.addEventListener("click", () => {
        const column = more.closest(".swap-io-col");
        const open = column?.classList.toggle("is-open") ?? false;
        more.setAttribute("aria-expanded", String(open));
        const label = more.querySelector<HTMLElement>("[data-more-label]");
        if (label) label.textContent = open ? "Show fewer" : (label.dataset.moreLabel ?? "");
      });
    }
  }
</script>

<style>
  /* App dark-theme values copied literally, so the panel reads as the app:
     --background oklch(0.145 0 0), --muted oklch(0.269 0 0),
     --muted-foreground oklch(0.708 0 0), --primary oklch(0.922 0 0). */
  .swap-mock {
    --sm-surface: #0f0f11;
    --sm-bg: #0a0a0a;
    --sm-muted: #262626;
    --sm-muted-fg: #a1a1a1;
    --sm-border: rgba(255, 255, 255, 0.1);
    --sm-primary: #e5e5e5;

    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--sm-surface);
    box-shadow: 0 24px 56px -28px rgba(0, 0, 0, 0.75);
    padding: 20px;
  }

  /* ── Paired route ─────────────────────────────────────── */
  .swap-route {
    border: 1px solid var(--sm-border);
    border-radius: 8px;
    background: rgb(38 38 38 / 0.25);
    padding: 12px;
  }

  .swap-route-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .swap-route-icon {
    width: 16px;
    height: 16px;
    flex: none;
    color: #0ea5e9;
  }

  .swap-route-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(170px, 0.9fr) minmax(0, 1fr);
    gap: 8px;
    margin-top: 12px;
    align-items: stretch;
  }

  .swap-leg {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 9px 12px;
    text-align: left;
    border: 1px solid var(--sm-border);
    border-radius: 7px;
    background: var(--sm-bg);
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }

  .swap-leg:hover {
    border-color: rgb(229 229 229 / 0.4);
    background: rgb(229 229 229 / 0.05);
  }

  [data-leg="liquid"] .swap-leg[data-leg-btn="liquid"],
  [data-leg="bitcoin"] .swap-leg[data-leg-btn="bitcoin"] {
    border-color: rgb(229 229 229 / 0.6);
    background: rgb(229 229 229 / 0.1);
  }

  .swap-leg-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .swap-leg-key {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--sm-muted-fg);
    white-space: nowrap;
  }

  .swap-leg-chip {
    flex: none;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.35;
    padding: 0 6px;
    border: 1px solid var(--sm-border);
    border-radius: 6px;
    color: var(--fg);
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  [data-leg="liquid"] .swap-leg[data-leg-btn="liquid"] .swap-leg-chip,
  [data-leg="bitcoin"] .swap-leg[data-leg-btn="bitcoin"] .swap-leg-chip {
    opacity: 1;
  }

  .swap-leg-asset {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--fg);
  }

  .swap-leg-asset img {
    width: 14px;
    height: 14px;
    object-fit: contain;
  }

  .swap-leg-amt {
    font-size: 13px;
    font-weight: 500;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .swap-peg {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 0;
    padding: 6px 10px;
    text-align: center;
  }

  .swap-peg-arrow {
    width: 15px;
    height: 15px;
    flex: none;
    color: var(--sm-muted-fg);
  }

  .swap-peg-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }

  .swap-peg-name {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
  }

  .swap-peg-policy {
    margin-top: 3px;
    font-size: 11.5px;
    color: var(--sm-muted-fg);
  }

  .swap-peg-fee {
    margin-top: 7px;
    padding: 1px 6px;
    font-size: 10px;
    font-weight: 500;
    color: var(--sm-muted-fg);
    border: 1px solid rgb(255 255 255 / 0.07);
    border-radius: 6px;
    background: rgb(38 38 38 / 0.35);
    font-variant-numeric: tabular-nums;
  }

