---
/*
 * Interactive mock of Kassiber's swap detail: the paired swap route with its
 * leg toggle, and the transaction-flow sankey underneath. Ported from the
 * app's swap detail screen (regtest demo book, Swap LBTC -> BTC) the same way
 * HeroChatMock ports the composer: app dark-theme values copied literally.
 *
 * The leg cards are real buttons. Selecting a leg swaps the graph and its
 * subtitle, exactly like the app: the Liquid side is a reference graph with
 * confidential amounts, the Bitcoin side is the valued input/output graph.
 */
---

<div class="swap-mock" data-leg="liquid">
  <div class="swap-route" role="group" aria-label="Paired swap route">
    <button class="swap-leg" type="button" data-leg-btn="liquid" aria-pressed="true">
      <span class="swap-leg-head">
        <span class="swap-leg-key">Spent leg</span>
        <span class="swap-leg-chip">Selected</span>
      </span>
      <span class="swap-leg-asset"><img src="/harnesses/liquid.svg" alt="" /> Liquid</span>
      <span class="swap-leg-amt">&#8383; 0.04200000</span>
    </button>

    <div class="swap-peg" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
    </div>

    <button class="swap-leg" type="button" data-leg-btn="bitcoin" aria-pressed="false">
      <span class="swap-leg-head">
        <span class="swap-leg-key">Received leg</span>
        <span class="swap-leg-chip">Selected</span>
      </span>
      <span class="swap-leg-asset"><img src="/harnesses/bitcoin.svg" alt="" /> Bitcoin</span>
      <span class="swap-leg-amt">&#8383; 0.04195800</span>
    </button>
  </div>

  <div class="swap-graph-head">
    <div class="swap-graph-title">Transaction graph</div>
  </div>

  <!-- Liquid leg: a consolidation — eight internal legs converge into the one
       output funding the swap; the fee arcs away above. -->
  <svg class="swap-sankey" data-sankey="liquid" viewBox="0 0 718 280" aria-hidden="true"><defs><marker id="swapmock-liquid-input-marker" viewBox="-5 -5 10 10" refX="0" refY="0" markerUnits="strokeWidth" markerWidth="1.5" markerHeight="1" orient="auto"><path d="M -5 -5 L 0 0 L -5 5 L 1 5 L 1 -5 Z" stroke-width="0" fill="rgb(59 130 246)"></path></marker><marker id="swapmock-liquid-input-hover-marker" viewBox="-5 -5 10 10" refX="0" refY="0" markerUnits="strokeWidth" markerWidth="1.5" markerHeight="1" orient="auto"><path d="M -5 -5 L 0 0 L -5 5 L 1 5 L 1 -5 Z" stroke-width="0" fill="rgb(96 165 250)"></path></marker><marker id="swapmock-liquid-output-marker" viewBox="-5 -5 10 10" refX="0" refY="0" markerUnits="strokeWidth" markerWidth="1.5" markerHeight="1" orient="auto"><path d="M 1 -5 L 0 -5 L -5 0 L 0 5 L 1 5 Z" stroke-width="0" fill="rgb(59 130 246)"></path></marker><marker id="swapmock-liquid-output-hover-marker" viewBox="-5 -5 10 10" refX="0" refY="0" markerUnits="strokeWidth" markerWidth="1.5" markerHeight="1" orient="auto"><path d="M 1 -5 L 0 -5 L -5 0 L 0 5 L 1 5 Z" stroke-width="0" fill="rgb(96 165 250)"></path></marker><linearGradient id="swapmock-liquid-input-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(59 130 246)"></stop><stop offset="100%" stop-color="rgb(14 165 233)"></stop></linearGradient><linearGradient id="swapmock-liquid-input-hover-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(96 165 250)"></stop><stop offset="100%" stop-color="rgb(34 211 238)"></stop></linearGradient><linearGradient id="swapmock-liquid-output-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(14 165 233)"></stop><stop offset="100%" stop-color="rgb(59 130 246)"></stop></linearGradient><linearGradient id="swapmock-liquid-output-hover-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(34 211 238)"></stop><stop offset="100%" stop-color="rgb(96 165 250)"></stop></linearGradient><linearGradient id="swapmock-liquid-fee-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(14 165 233)"></stop><stop offset="52%" stop-color="rgb(245 158 11)"></stop><stop offset="100%" stop-color="transparent"></stop></linearGradient><linearGradient id="swapmock-liquid-fee-hover-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(34 211 238)"></stop><stop offset="58%" stop-color="rgb(251 191 36)"></stop><stop offset="100%" stop-color="transparent"></stop></linearGradient></defs><path d="M 97.25 30 L 102.25 30 C 210 30, 210 112, 317 112 L 360 112" fill="none" stroke="url(#swapmock-liquid-input-gradient)" stroke-width="8" stroke-linecap="butt" marker-start="url(#swapmock-liquid-input-marker)"></path><path d="M 97.25 62 L 102.25 62 C 210 62, 210 120, 317 120 L 360 120" fill="none" stroke="url(#swapmock-liquid-input-gradient)" stroke-width="8" stroke-linecap="butt" marker-start="url(#swapmock-liquid-input-marker)"></path><path d="M 97.25 94 L 102.25 94 C 210 94, 210 128, 317 128 L 360 128" fill="none" stroke="url(#swapmock-liquid-input-gradient)" stroke-width="8" stroke-linecap="butt" marker-start="url(#swapmock-liquid-input-marker)"></path><path d="M 97.25 126 L 102.25 126 C 210 126, 210 136, 317 136 L 360 136" fill="none" stroke="url(#swapmock-liquid-input-gradient)" stroke-width="8" stroke-linecap="butt" marker-start="url(#swapmock-liquid-input-marker)"></path><path d="M 97.25 158 L 102.25 158 C 210 158, 210 144, 317 144 L 360 144" fill="none" stroke="url(#swapmock-liquid-input-gradient)" stroke-width="8" stroke-linecap="butt" marker-start="url(#swapmock-liquid-input-marker)"></path><path d="M 97.25 190 L 102.25 190 C 210 190, 210 152, 317 152 L 360 152" fill="none" stroke="url(#swapmock-liquid-input-gradient)" stroke-width="8" stroke-linecap="butt" marker-start="url(#swapmock-liquid-input-marker)"></path><path d="M 97.25 222 L 102.25 222 C 210 222, 210 160, 317 160 L 360 160" fill="none" stroke="url(#swapmock-liquid-input-gradient)" stroke-width="8" stroke-linecap="butt" marker-start="url(#swapmock-liquid-input-marker)"></path><path d="M 97.25 254 L 102.25 254 C 210 254, 210 168, 317 168 L 360 168" fill="none" stroke="url(#swapmock-liquid-input-gradient)" stroke-width="8" stroke-linecap="butt" marker-start="url(#swapmock-liquid-input-marker)"></path><path d="M 654 40.25 L 618.81 40.25 C 511 40.25, 511 107.75, 403.19 107.75 L 358 107.75" fill="none" stroke="url(#swapmock-liquid-fee-gradient)" stroke-width="1.5" stroke-linecap="butt"></path><path d="M 621 140.25 L 616 140.25 C 511 140.25, 511 140, 406 140 L 360 140" fill="none" stroke="url(#swapmock-liquid-output-gradient)" stroke-width="64" stroke-linecap="butt" marker-start="url(#swapmock-liquid-output-marker)"></path></svg>

  <!-- Bitcoin leg: one in, one out — the received amount flows straight
       through, minus the fee wisp. -->
  <svg class="swap-sankey" data-sankey="bitcoin" viewBox="0 0 718 280" aria-hidden="true"><defs><marker id="swapmock-bitcoin-input-marker" viewBox="-5 -5 10 10" refX="0" refY="0" markerUnits="strokeWidth" markerWidth="1.5" markerHeight="1" orient="auto"><path d="M -5 -5 L 0 0 L -5 5 L 1 5 L 1 -5 Z" stroke-width="0" fill="rgb(59 130 246)"></path></marker><marker id="swapmock-bitcoin-input-hover-marker" viewBox="-5 -5 10 10" refX="0" refY="0" markerUnits="strokeWidth" markerWidth="1.5" markerHeight="1" orient="auto"><path d="M -5 -5 L 0 0 L -5 5 L 1 5 L 1 -5 Z" stroke-width="0" fill="rgb(96 165 250)"></path></marker><marker id="swapmock-bitcoin-output-marker" viewBox="-5 -5 10 10" refX="0" refY="0" markerUnits="strokeWidth" markerWidth="1.5" markerHeight="1" orient="auto"><path d="M 1 -5 L 0 -5 L -5 0 L 0 5 L 1 5 Z" stroke-width="0" fill="rgb(59 130 246)"></path></marker><marker id="swapmock-bitcoin-output-hover-marker" viewBox="-5 -5 10 10" refX="0" refY="0" markerUnits="strokeWidth" markerWidth="1.5" markerHeight="1" orient="auto"><path d="M 1 -5 L 0 -5 L -5 0 L 0 5 L 1 5 Z" stroke-width="0" fill="rgb(96 165 250)"></path></marker><linearGradient id="swapmock-bitcoin-input-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(59 130 246)"></stop><stop offset="100%" stop-color="rgb(14 165 233)"></stop></linearGradient><linearGradient id="swapmock-bitcoin-input-hover-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(96 165 250)"></stop><stop offset="100%" stop-color="rgb(34 211 238)"></stop></linearGradient><linearGradient id="swapmock-bitcoin-output-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(14 165 233)"></stop><stop offset="100%" stop-color="rgb(59 130 246)"></stop></linearGradient><linearGradient id="swapmock-bitcoin-output-hover-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(34 211 238)"></stop><stop offset="100%" stop-color="rgb(96 165 250)"></stop></linearGradient><linearGradient id="swapmock-bitcoin-fee-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(14 165 233)"></stop><stop offset="52%" stop-color="rgb(245 158 11)"></stop><stop offset="100%" stop-color="transparent"></stop></linearGradient><linearGradient id="swapmock-bitcoin-fee-hover-gradient" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="rgb(34 211 238)"></stop><stop offset="58%" stop-color="rgb(251 191 36)"></stop><stop offset="100%" stop-color="transparent"></stop></linearGradient></defs><path d="M 97.25 139 L 102.25 139 C 209.72 139, 209.72 140.25, 317.19 140.25 L 360 140.25" fill="none" stroke="url(#swapmock-bitcoin-input-gradient)" stroke-width="66.5" stroke-linecap="butt" marker-start="url(#swapmock-bitcoin-input-marker)"></path><path d="M 654 41.5 L 606.64 41.5 C 511 41.5, 511 109, 415.36 109 L 358 109" fill="none" stroke="url(#swapmock-bitcoin-fee-gradient)" stroke-width="1.5" stroke-linecap="butt"></path><path d="M 620.75 140.5 L 613.94 140.5 C 511 140.5, 511 140.25, 408.06 140.25 L 358 140.25" fill="none" stroke="url(#swapmock-bitcoin-output-gradient)" stroke-width="66" stroke-linecap="butt" marker-start="url(#swapmock-bitcoin-output-marker)"></path></svg>

  <!-- Deliberately abstract: the graph already carries the shape, so the
       ledger below only names the two sides. -->
  <div class="swap-io" aria-hidden="true">
    <div class="swap-io-col">
      <div class="swap-io-head">Inputs</div>
      <div class="swap-io-dots">&hellip;</div>
    </div>
    <div class="swap-io-col">
      <div class="swap-io-head">Outputs</div>
      <div class="swap-io-dots">&hellip;</div>
    </div>
  </div>
</div>

<script>
  for (const mock of document.querySelectorAll<HTMLElement>(".swap-mock")) {
    const buttons = [...mock.querySelectorAll<HTMLButtonElement>("[data-leg-btn]")];
    let automatic = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const select = (leg: string) => {
      mock.dataset.leg = leg;
      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset.legBtn === leg));
      }
    };

    const timer = window.setInterval(() => {
      if (automatic) select(mock.dataset.leg === "liquid" ? "bitcoin" : "liquid");
    }, 4200);

    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        automatic = false;
        window.clearInterval(timer);
        select(btn.dataset.legBtn ?? "liquid");
      });
    }
  }
</script>

<style>
  /* App dark-theme values copied literally, so the panel reads as the app. */
  /* No card: the route, graph, and ledger sit straight on the section. */
  .swap-mock {
    overflow: hidden;
    padding: 0;
  }

  /* ── Paired route ─────────────────────────────────────── */
  .swap-route {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 12px;
    align-items: stretch;
  }

  .swap-leg {
    display: flex;
    flex-direction: column;
    gap: 5px;
    text-align: left;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 9px;
    background: #101014;
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .swap-leg:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  [data-leg="liquid"] .swap-leg[data-leg-btn="liquid"],
  [data-leg="bitcoin"] .swap-leg[data-leg-btn="bitcoin"] {
    border-color: rgba(255, 255, 255, 0.38);
    background: #131318;
  }

  .swap-leg-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .swap-leg-key {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
    white-space: nowrap;
  }

  .swap-leg-chip {
    font-size: 10px;
    line-height: 1;
    padding: 4px 7px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 6px;
    color: var(--fg);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  [data-leg="liquid"] .swap-leg[data-leg-btn="liquid"] .swap-leg-chip,
  [data-leg="bitcoin"] .swap-leg[data-leg-btn="bitcoin"] .swap-leg-chip {
    opacity: 1;
  }

  .swap-leg-asset {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .swap-leg-asset img {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  .swap-leg-amt {
    font-size: 13px;
    color: var(--fg-muted);
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
  }

  .swap-peg {
    display: grid;
    align-items: center;
    place-items: center;
    color: var(--fg-dim);
  }

  .swap-peg > svg {
    width: 20px;
    height: 20px;
    flex: none;
  }

  /* ── Graph ────────────────────────────────────────────── */
  .swap-graph-head {
    margin: 18px 4px 10px;
  }

  .swap-graph-title {
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 3px;
  }

  .swap-sankey {
    display: none;
    width: 100%;
    height: auto;
    transform: translateX(-17.5%) scaleX(1.29);
    transform-origin: left center;
  }

  [data-leg="liquid"] .swap-sankey[data-sankey="liquid"],
  [data-leg="bitcoin"] .swap-sankey[data-sankey="bitcoin"] {
    display: block;
    animation: swapSankeyIn 0.35s ease;
  }

  @keyframes swapSankeyIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-leg] .swap-sankey {
      animation: none;
    }
  }

  /* ── Inputs / outputs ─────────────────────────────────── */
  .swap-io {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin: 10px 4px 0;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .swap-io-head {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: 6px;
  }

  .swap-io-dots {
    font-family: var(--font-mono);
    font-size: 17px;
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--fg-dim);
  }

  /* Touch: no hover to hint with, so the two legs become a segmented control —
     both options always visible, the selected one filled. Half the height of
     the stacked cards, and obviously a choice. */
  @media (max-width: 560px) {
    .swap-route {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .swap-leg {
      grid-row: 1;
      gap: 3px;
      padding: 10px 11px;
      min-height: 64px;
      justify-content: center;
      background: rgba(255, 255, 255, 0.02);
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }

    [data-leg="liquid"] .swap-leg[data-leg-btn="liquid"],
    [data-leg="bitcoin"] .swap-leg[data-leg-btn="bitcoin"] {
      background: rgba(255, 255, 255, 0.09);
      border-color: rgba(255, 255, 255, 0.45);
    }

    /* The fill carries the state on a phone; the chip is redundant width. */
    .swap-leg-chip {
      display: none;
    }

    .swap-leg-asset {
      font-size: 13.5px;
    }

    .swap-leg-amt {
      font-size: 11.5px;
    }

    /* The peg drops to one line under the pair it joins. */
    .swap-peg {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: center;
      padding-top: 2px;
    }

    /* The legs sit left-to-right again, so the arrows point that way too. */
    .swap-peg > svg {
      transform: none;
      width: 13px;
      height: 13px;
    }

  }
</style>
