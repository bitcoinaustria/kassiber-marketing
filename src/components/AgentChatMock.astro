---
/*
 * Three questions worth asking, each one hard to answer anywhere else: what a
 * year actually earned, what your own books give away about you, and the
 * proof-of-funds bundle a bank asks for.
 *
 * Nobody has to ask for transfers to be left out of income. Kassiber pairs them
 * on its own, so that belongs in the answer as something already done, never in
 * the question as an instruction: a demo where the user coaches the tool is a
 * demo about a tool that needs coaching.
 *
 * Deliberately not the tax filing. The section above it already argues that
 * case, and an agent that can only produce a tax form is a narrower thing than
 * this one is.
 *
 * An agent transcript, not a chatbot. The section claims agents are first
 * class, so the panel has to show the thing that makes them first class: the
 * command it ran, in the real CLI's real syntax, and what came back. Answers
 * that simply appear are how a product demo looks; work that is visible is how
 * an agent looks.
 *
 * Every command here is checked against the installed CLI, so anyone who has
 * it can paste one and watch it work. Guessed flags would be found out by
 * exactly the people this section is addressed to.
 *
 * Prose streams a word at a time and each command takes as long as its work
 * plausibly would: a year-wide rollup is slow, a single-row lookup is quick,
 * writing a workbook is slowest. One uniform pause for all three was what made
 * the old version read as a slideshow.
 */

const MONTHS = [
  { m: "J", incoming: 6, outgoing: 2, transfers: 4, swaps: 1 },
  { m: "F", incoming: 4, outgoing: 3, transfers: 3, swaps: 0 },
  { m: "M", incoming: 7, outgoing: 2, transfers: 8, swaps: 2 },
  { m: "A", incoming: 5, outgoing: 4, transfers: 5, swaps: 1 },
  { m: "M", incoming: 3, outgoing: 5, transfers: 4, swaps: 0 },
  { m: "J", incoming: 6, outgoing: 3, transfers: 6, swaps: 1 },
  { m: "J", incoming: 4, outgoing: 2, transfers: 5, swaps: 3 },
  { m: "A", incoming: 7, outgoing: 4, transfers: 7, swaps: 1 },
  { m: "S", incoming: 3, outgoing: 6, transfers: 4, swaps: 2 },
  { m: "O", incoming: 5, outgoing: 3, transfers: 6, swaps: 0 },
  { m: "N", incoming: 8, outgoing: 2, transfers: 8, swaps: 1 },
  { m: "D", incoming: 4, outgoing: 4, transfers: 5, swaps: 0 },
];

/* What it says back, split into words here rather than in the browser.
   Component CSS is scoped by an attribute Astro stamps onto template elements,
   and a span created by script never carries it, so the fade and the caret
   simply did not apply and the whole sentence appeared at once. Authoring the
   words also means the full answer is there with no JS at all. */
const SAY = {
  year:
    "Money in, money out, transfers, and swaps. Your moves between your own wallets were already paired off, so none of them count as income.",
  privacy:
    "Two of them. Reused addresses tie your history together, and merged inputs prove the wallets are one owner.",
  funds:
    "Every lot traced back to the day it arrived, with the exchange records attached. Hand them the file, not your wallets.",
};
const words = (s: string) => s.split(" ");

// Chart geometry mirrors the app's grouped transaction-overview bars.
const W = 320;
const H = 94;
const BASE = 62;
const DENSITY = 0.75;
const maxActivity = Math.max(...MONTHS.flatMap((x) => [x.incoming, x.outgoing, x.transfers, x.swaps]));
const slot = (W - 8) / MONTHS.length;
const bars = MONTHS.map((x, i) => {
  const incomingHeight = Math.max(2, (x.incoming / maxActivity) * (BASE - 12) * DENSITY);
  const outgoingHeight = Math.max(2, (x.outgoing / maxActivity) * 15 * DENSITY);
  const transferHeight = Math.max(2, (x.transfers / maxActivity) * (BASE - 12) * DENSITY);
  const swapHeight = x.swaps ? Math.max(2, (x.swaps / maxActivity) * (BASE - 12) * DENSITY) : 0;
  return {
    ...x,
    x: 5 + i * slot,
    incomingHeight,
    outgoingHeight,
    transferHeight,
    swapHeight,
    width: Math.max(2, (slot - 8) / 4),
  };
});
---

<div class="chat" data-turn="0">
  <!-- Which harness, which model, and where it runs. The section is about
       agents, so the panel says which one is holding the wheel. -->
  <div class="chat-head">
    <span class="harness">opencode</span>
    <span class="head-right">
      <span class="model">Qwen3.6-35B · oMLX<i class="local">local</i></span>
      <!-- In the bar rather than floating over it: pinned to the corner it
           landed on the model badge, and over a card once one arrived. -->
      <button class="replay" type="button" data-replay>Replay</button>
    </span>
  </div>

  <div class="chat-log" data-log>
    <!-- ── 1 · the year at a glance ─────────────────────────── -->
    <div class="msg you" data-at="1">What did I actually earn last year?</div>

    <div class="msg bot" data-at="2">
      <div class="tool" data-tool data-dur="1500" data-out="1,284 transactions, 12 months">
        <div class="trow">
          <span class="tdot" aria-hidden="true"></span>
          <span class="tbody">
            <span class="tact">Reading your book</span>
            <code>kassiber reports summary</code>
          </span>
        </div>
        <div class="tout" data-tout></div>
      </div>

      <p data-stream>{words(SAY.year).map((w) => <span>{`${w} `}</span>)}</p>

      <div class="card" data-card>
        <div class="chart-head">
          <span>Transaction activity</span>
          <span>2025 · count</span>
        </div>
        <svg
          class="spark"
          viewBox={`0 0 ${W} ${H}`}
          role="img"
          aria-label="Transaction activity by month in 2025, split into incoming, outgoing, transfers, and swaps"
        >
          <line x1="0" y1="12" x2={W} y2="12" class="grid" />
          <line x1="0" y1="42" x2={W} y2="42" class="grid" />
          <line x1="0" y1={BASE} x2={W} y2={BASE} class="axis" />
          {/* Delay per month, so the year fills in left to right rather than
              appearing at once. Each series is nudged a little further so the
              sweep has some depth instead of moving as one block. */}
          {bars.map((b, i) => (
            <rect x={b.x} y={BASE - b.incomingHeight} width={b.width} height={b.incomingHeight} rx="1.5" class="bar incoming" style={`--bd:${i * 38}ms`} />
          ))}
          {bars.map((b, i) => (
            <rect x={b.x + b.width + 1} y={BASE} width={b.width} height={b.outgoingHeight} rx="1.5" class="bar outgoing" style={`--bd:${i * 38 + 20}ms`} />
          ))}
          {bars.map((b, i) => (
            <rect x={b.x + (b.width + 1) * 2} y={BASE - b.transferHeight} width={b.width} height={b.transferHeight} rx="1.5" class="bar transfer" style={`--bd:${i * 38 + 40}ms`} />
          ))}
          {bars.map((b, i) => (
            <rect x={b.x + (b.width + 1) * 3} y={BASE - b.swapHeight} width={b.width} height={b.swapHeight} rx="1.5" class="bar swap" style={`--bd:${i * 38 + 80}ms`} />
          ))}
          {bars.map((b) => (
            <text x={b.x + slot / 2 - 2} y={H - 2} class="mo">{b.m}</text>
          ))}
        </svg>
        <div class="legend">
          <span><i class="dot incoming"></i>Incoming</span>
          <span><i class="dot outgoing"></i>Outgoing</span>
          <span><i class="dot transfer"></i>Transfers</span>
          <span><i class="dot swap"></i>Swaps</span>
        </div>
      </div>
    </div>

    <!-- ── 2 · what the books say about you ─────────────────── -->
    <div class="msg you" data-at="3">Which of my wallets leak the most about me?</div>

    <div class="msg bot" data-at="4">
      <div class="tool" data-tool data-dur="1100" data-out="3 things worth fixing">
        <div class="trow">
          <span class="tdot" aria-hidden="true"></span>
          <span class="tbody">
            <span class="tact">Checking what your wallets reveal</span>
            <code>kassiber reports privacy-hygiene</code>
          </span>
        </div>
        <div class="tout" data-tout></div>
      </div>

      <p data-stream>{words(SAY.privacy).map((w) => <span>{`${w} `}</span>)}</p>

      <div class="card" data-card>
        <div class="card-top">
          <span class="card-name">Privacy hygiene</span>
          <span class="amt">3 findings</span>
        </div>
        <dl class="kv">
          <div><dt>Reused addresses</dt><dd class="hot" data-count="14" data-suffix=" outputs">14 outputs</dd></div>
          <div><dt>Merged inputs</dt><dd data-count="2" data-suffix=" wallets">2 wallets</dd></div>
          <div><dt>Round-number withdrawals</dt><dd data-count="6">6</dd></div>
        </dl>
      </div>
    </div>

    <!-- ── 3 · the document a bank asks for, built here ─────── -->
    <div class="msg you" data-at="5">My bank wants proof of where the coins came from. Build it.</div>

    <div class="msg bot" data-at="6">
      <div class="tool" data-tool data-dur="2400" data-out="41 pages, ready to send">
        <div class="trow">
          <span class="tdot" aria-hidden="true"></span>
          <span class="tbody">
            <span class="tact">Building the file for your bank</span>
            <code>kassiber reports export-source-funds-bundle --file source-of-funds.zip</code>
          </span>
        </div>
        <div class="tout" data-tout></div>
      </div>

      <p data-stream>{words(SAY.funds).map((w) => <span>{`${w} `}</span>)}</p>

      <div class="card" data-card>
        <div class="card-top">
          <span class="card-name">Source of funds · case bank-2025</span>
          <span class="amt" data-count="4.21830000" data-decimals="8" data-suffix="&#8239;₿">4.21830000&#8239;₿</span>
        </div>
        <div class="attach">
          <span class="clip" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21.4 11.05 12.25 20.2a5.5 5.5 0 0 1-7.78-7.78l8.49-8.48a3.67 3.67 0 1 1 5.18 5.18l-8.48 8.49a1.83 1.83 0 0 1-2.6-2.6l7.79-7.78"/></svg>
          </span>
          <span class="file">source-of-funds.zip</span>
          <span class="download-icon" aria-label="Download">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
          </span>
        </div>
        <div class="card-foot">
          <span>every lot traced to its origin</span>
          <span>built here, sent by you</span>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const chat of document.querySelectorAll<HTMLElement>(".chat")) {
    const log = chat.querySelector<HTMLElement>("[data-log]");
    if (!log) continue;
    const msgs = [...chat.querySelectorAll<HTMLElement>(".msg")];
    const tools = [...chat.querySelectorAll<HTMLElement>("[data-tool]")];
    const cards = [...chat.querySelectorAll<HTMLElement>("[data-card]")];
    /* The words are already spans, one per word, rendered by the component.
       Arming them is what hides them; every word keeps its place from the first
       frame and only its opacity changes, so nothing reflows as the sentence
       arrives. */
    const proses = new Map<HTMLElement, HTMLElement[]>();
    for (const p of chat.querySelectorAll<HTMLElement>("[data-stream]")) {
      p.classList.add("is-armed");
      proses.set(p, [...p.querySelectorAll<HTMLElement>("span")]);
    }

    const counters = [...chat.querySelectorAll<HTMLElement>("[data-count]")];
    const countText = (el: HTMLElement, v: number) =>
      v.toFixed(Number(el.dataset.decimals ?? 0)) + (el.dataset.suffix ?? "");

    /* Counts up to the real figure. A number that lands already finished is
       just text; one that climbs reads as something being worked out.
       On the same timers as everything else, not on animation frames: frames
       are throttled while the tab is in the background, which left the figure
       sitting on the zero it was reset to, and a stray frame loop outlived
       Replay. The last tick assigns the target exactly, so the number on screen
       is never a rounded approximation of itself. */
    const TICKS = 26;
    const countUp = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target)) return;
      let f = 0;
      const tick = () => {
        f += 1;
        const k = f / TICKS;
        el.textContent = countText(el, f >= TICKS ? target : target * (1 - Math.pow(1 - k, 3)));
        if (f < TICKS) later(tick, 32);
      };
      tick();
    };

    let timers: number[] = [];
    const later = (fn: () => void, ms: number) => {
      timers.push(window.setTimeout(fn, ms) as unknown as number);
    };
    const clear = () => {
      timers.forEach((t) => window.clearTimeout(t));
      timers = [];
    };

    // Follow the conversation, the way a chat pane does.
    const follow = () => log.scrollTo({ top: log.scrollHeight, behavior: "auto" });

    const reset = () => {
      chat.classList.remove("is-busy");
      for (const m of msgs) m.classList.remove("is-in");
      for (const t of tools) {
        t.classList.remove("is-run", "is-done");
        const out = t.querySelector<HTMLElement>("[data-tout]");
        if (out) out.textContent = "";
      }
      for (const c of cards) c.classList.remove("is-in");
      for (const spans of proses.values()) {
        for (const s of spans) s.classList.remove("on", "tip");
      }
      for (const el of counters) el.textContent = countText(el, 0);
      chat.dataset.turn = "0";
      log.scrollTop = 0;
    };

    // The end state, arrived at with no journey. Where reduced motion lives.
    const settle = () => {
      clear();
      reset();
      for (const m of msgs) m.classList.add("is-in");
      for (const t of tools) {
        t.classList.add("is-done");
        const out = t.querySelector<HTMLElement>("[data-tout]");
        if (out) out.textContent = t.dataset.out ?? "";
      }
      for (const c of cards) c.classList.add("is-in");
      for (const spans of proses.values()) {
        for (const s of spans) s.classList.add("on");
      }
      for (const el of counters) el.textContent = countText(el, Number(el.dataset.count));
      chat.dataset.turn = "6";
      follow();
    };

    /* A word at a time, because that is what generated text looks like. Fast
       enough to read as output rather than as a typewriter effect. */
    const stream = (p: HTMLElement, done: () => void) => {
      const spans = proses.get(p) ?? [];
      let i = 0;
      const tick = () => {
        spans[i - 1]?.classList.remove("tip");
        const s = spans[i++];
        s?.classList.add("on", "tip");
        follow();
        if (i < spans.length) later(tick, 26);
        else {
          s?.classList.remove("tip");
          done();
        }
      };
      tick();
    };

    type Step = { wait: number; run: (next: () => void) => void };
    const runSeq = (steps: Step[], i = 0) => {
      if (i >= steps.length) return;
      later(() => steps[i].run(() => runSeq(steps, i + 1)), steps[i].wait);
    };

    const play = () => {
      clear();
      reset();

      const steps: Step[] = [];
      const asks = msgs.filter((m) => m.classList.contains("you"));

      asks.forEach((ask, k) => {
        const answer = msgs[msgs.indexOf(ask) + 1];
        const tool = answer?.querySelector<HTMLElement>("[data-tool]");
        const out = tool?.querySelector<HTMLElement>("[data-tout]");
        const prose = answer?.querySelector<HTMLElement>("[data-stream]");
        const card = answer?.querySelector<HTMLElement>("[data-card]");

        // The question lands. A first one arrives sooner than a follow-up.
        steps.push({ wait: k === 0 ? 420 : 950, run: (n) => { ask.classList.add("is-in"); follow(); n(); } });
        // It reaches for a command before it says anything.
        steps.push({ wait: 460, run: (n) => { answer?.classList.add("is-in"); tool?.classList.add("is-run"); chat.classList.add("is-busy"); follow(); n(); } });
        // Held for as long as that command's own work would take.
        steps.push({
          wait: Number(tool?.dataset.dur ?? 900),
          run: (n) => {
            tool?.classList.replace("is-run", "is-done");
            if (out && tool) out.textContent = tool.dataset.out ?? "";
            follow();
            n();
          },
        });
        steps.push({ wait: 280, run: (n) => (prose ? stream(prose, n) : n()) });
        // The card, and any figure on it, once the sentence introducing it is out.
        steps.push({
          wait: 200,
          run: (n) => {
            card?.classList.add("is-in");
            if (card) for (const el of card.querySelectorAll<HTMLElement>("[data-count]")) countUp(el);
            follow();
            n();
          },
        });
        // Idle again until the next question, so the badge only breathes on work.
        steps.push({ wait: 260, run: (n) => { chat.classList.remove("is-busy"); n(); } });
        if (k === asks.length - 1) {
          steps.push({ wait: 0, run: (n) => { chat.dataset.turn = "6"; n(); } });
        }
      });

      runSeq(steps);
    };

    chat.querySelector("[data-replay]")?.addEventListener("click", play);

    if (REDUCED) {
      settle();
      continue;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          play();
        }
      },
      { threshold: 0.3 },
    );
    io.observe(chat);
  }
</script>

<style>
  .chat {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: 0 24px 56px -28px rgba(0, 0, 0, 0.75);
    overflow: hidden;
  }

  /* A fixed pane the conversation scrolls inside, so three exchanges cost the
     section no more height than one. */
  .chat-log {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 452px;
    overflow-y: auto;
    padding: 18px;
    scrollbar-color: rgba(255, 255, 255, 0.14) transparent;
    scrollbar-width: thin;
  }

  .chat-log::-webkit-scrollbar { width: 6px; }

  .chat-log::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.14);
    border-radius: 999px;
  }

  /* ── Messages ─────────────────────────────────────────── */
  /* Not-yet-sent messages take no space at all: the pane has to grow as the
     conversation arrives, otherwise scrolling to the bottom lands past a stack
     of invisible ones and the chat looks empty. */
  .msg { display: none; }

  .msg.is-in {
    display: block;
    animation: msgIn 0.3s ease both;
  }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  .you {
    align-self: flex-end;
    max-width: 84%;
    padding: 9px 13px;
    border-radius: 14px 14px 4px 14px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--fg);
    font-size: 14px;
    line-height: 1.45;
    letter-spacing: -0.005em;
  }

  .bot {
    align-self: flex-start;
    max-width: 96%;
  }

  .bot p {
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--fg-muted);
    margin-bottom: 10px;
  }

  /* Words are all in the layout from the first frame and only fade in, so the
     paragraph never reflows while it arrives and the card below it never walks
     down the pane. Appending text did both.
     Only hidden once the script has taken charge: without it the sentence has
     to read normally rather than be invisible forever. */
  [data-stream].is-armed span {
    opacity: 0;
    transition: opacity 240ms ease;
  }

  [data-stream].is-armed span.on { opacity: 1; }

  /* Rides the leading edge, so the eye has somewhere to sit while it fills. */
  [data-stream].is-armed span.tip::after {
    content: "";
    display: inline-block;
    width: 0.42em;
    height: 0.95em;
    margin-left: 2px;
    vertical-align: -0.12em;
    background: var(--fg-dim);
    animation: caret 1s steps(2, jump-none) infinite;
  }

  @keyframes caret {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* ── Answer cards ─────────────────────────────────────── */
  /* Lands after the sentence that introduces it, so the answer arrives in the
     order it was written rather than all at once. */
  .card {
    display: none;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
    padding: 13px 14px;
  }

  .card.is-in {
    display: block;
    animation: msgIn 0.3s ease both;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 11px;
  }

  .card-name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .download-icon {
    display: grid;
    flex: none;
    width: 22px;
    height: 22px;
    place-items: center;
    color: var(--fg-dim);
  }

  .download-icon svg {
    width: 14px;
    height: 14px;
  }

  .kv > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 5px 0;
  }

  .kv dt {
    font-size: 13px;
    color: var(--fg-dim);
  }

  .kv dd {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .kv dd.hot {
    color: var(--warn);
    font-weight: 500;
  }

  .card-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin-top: 11px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 11.5px;
    color: var(--fg-faint);
  }

  .file {
    font-family: var(--font-mono);
    color: var(--fg-muted);
  }

  /* ── Monthly chart ────────────────────────────────────── */
  .chart-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    font-size: 11px;
    color: var(--fg-dim);
  }

  .chart-head span:first-child {
    color: var(--fg);
    font-weight: 600;
  }

  .spark {
    width: 100%;
    height: auto;
    display: block;
  }

  .grid {
    stroke: rgba(255, 255, 255, 0.055);
    stroke-width: 1;
  }

  .axis {
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 1.5;
  }

  .bar.incoming { fill: oklch(0.56 0.16 150); }
  .bar.outgoing { fill: var(--accent); }
  .bar.transfer { fill: oklch(0.56 0.04 260); }
  .bar.swap { fill: oklch(0.62 0.16 246); }

  /* Grown from the axis, the way the app draws them: money above the line,
     spending below it, so each bar rises or drops from where zero is. */
  .bar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  .bar.outgoing { transform-origin: 50% 0%; }

  .card.is-in .bar {
    animation: barGrow 560ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--bd, 0ms) both;
  }

  @keyframes barGrow {
    from { transform: scaleY(0); }
    to { transform: scaleY(1); }
