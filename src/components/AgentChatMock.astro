---
/*
 * Three questions to your own books, ending where it matters: the year at a
 * glance, a receipt already matched, and the finished filing you can audit.
 *
 * The monthly figures below are the source of truth — the year's total is
 * summed from them, so the filing card and the tax section's spreadsheet
 * cannot drift apart.
 */

const MONTHS = [
  { m: "J", v: 118.4, incoming: 6, outgoing: 2, transfers: 4, swaps: 1 },
  { m: "F", v: 96.2, incoming: 4, outgoing: 3, transfers: 3, swaps: 0 },
  { m: "M", v: 1412.6, incoming: 7, outgoing: 2, transfers: 8, swaps: 2 },
  { m: "A", v: 204.15, incoming: 5, outgoing: 4, transfers: 5, swaps: 1 },
  { m: "M", v: -62.3, incoming: 3, outgoing: 5, transfers: 4, swaps: 0 },
  { m: "J", v: 88.75, incoming: 6, outgoing: 3, transfers: 6, swaps: 1 },
  { m: "J", v: 173.4, incoming: 4, outgoing: 2, transfers: 5, swaps: 3 },
  { m: "A", v: 129.6, incoming: 7, outgoing: 4, transfers: 7, swaps: 1 },
  { m: "S", v: -318.4, incoming: 3, outgoing: 6, transfers: 4, swaps: 2 },
  { m: "O", v: 205.3, incoming: 5, outgoing: 3, transfers: 6, swaps: 0 },
  { m: "N", v: 246.87, incoming: 8, outgoing: 2, transfers: 8, swaps: 1 },
  { m: "D", v: 124.3, incoming: 4, outgoing: 4, transfers: 5, swaps: 0 },
];

// en-US grouping so these read identically to the tax section's spreadsheet.
const eur = (n: number) =>
  n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const gains = MONTHS.reduce((sum, x) => sum + x.v, 0);
const due = Math.round(gains * 0.275 * 100) / 100;
// Chart geometry mirrors the app's grouped transaction-overview bars.
const W = 320;
const H = 94;
const BASE = 62;
const DENSITY = 0.75;
const maxActivity = Math.max(...MONTHS.flatMap((x) => [x.incoming, x.outgoing, x.transfers, x.swaps]));
const slot = (W - 8) / MONTHS.length;
const bars = MONTHS.map((x, i) => {
  const incomingHeight = Math.max(2, (x.incoming / maxActivity) * (BASE - 12) * DENSITY);
  const outgoingHeight = Math.max(2, (x.outgoing / maxActivity) * 15 * DENSITY);
  const transferHeight = Math.max(2, (x.transfers / maxActivity) * (BASE - 12) * DENSITY);
  const swapHeight = x.swaps ? Math.max(2, (x.swaps / maxActivity) * (BASE - 12) * DENSITY) : 0;
  return {
    ...x,
    x: 5 + i * slot,
    incomingHeight,
    outgoingHeight,
    transferHeight,
    swapHeight,
    width: Math.max(2, (slot - 8) / 4),
  };
});
---

<div class="chat" data-turn="0">
  <div class="chat-log" data-log>
    <!-- ── 1 · the year at a glance ─────────────────────────── -->
    <div class="msg you" data-at="1">What moved through my wallets last year?</div>

    <div class="msg bot" data-at="2">
      <p>Money in, money out, transfers, and swaps. Separated without counting your own movement twice.</p>

      <div class="card">
        <div class="chart-head">
          <span>Transaction activity</span>
          <span>2025 · count</span>
        </div>
        <svg
          class="spark"
          viewBox={`0 0 ${W} ${H}`}
          role="img"
          aria-label="Transaction activity by month in 2025, split into incoming, outgoing, transfers, and swaps"
        >
          <line x1="0" y1="12" x2={W} y2="12" class="grid" />
          <line x1="0" y1="42" x2={W} y2="42" class="grid" />
          <line x1="0" y1={BASE} x2={W} y2={BASE} class="axis" />
          {bars.map((b) => (
            <rect x={b.x} y={BASE - b.incomingHeight} width={b.width} height={b.incomingHeight} rx="1.5" class="bar incoming" />
          ))}
          {bars.map((b) => (
            <rect x={b.x + b.width + 1} y={BASE} width={b.width} height={b.outgoingHeight} rx="1.5" class="bar outgoing" />
          ))}
          {bars.map((b) => (
            <rect x={b.x + (b.width + 1) * 2} y={BASE - b.transferHeight} width={b.width} height={b.transferHeight} rx="1.5" class="bar transfer" />
          ))}
          {bars.map((b) => (
            <rect x={b.x + (b.width + 1) * 3} y={BASE - b.swapHeight} width={b.width} height={b.swapHeight} rx="1.5" class="bar swap" />
          ))}
          {bars.map((b) => (
            <text x={b.x + slot / 2 - 2} y={H - 2} class="mo">{b.m}</text>
          ))}
        </svg>
        <div class="legend">
          <span><i class="dot incoming"></i>Incoming</span>
          <span><i class="dot outgoing"></i>Outgoing</span>
          <span><i class="dot transfer"></i>Transfers</span>
          <span><i class="dot swap"></i>Swaps</span>
        </div>
      </div>
    </div>

    <!-- ── 2 · the receipt ──────────────────────────────────── -->
    <div class="msg you" data-at="3">Biggest expense, receipt or not?</div>

    <div class="msg bot" data-at="4">
      <p>This one. The receipt was matched the day the invoice landed.</p>

      <div class="card">
        <div class="card-top">
          <span class="card-name">12 Mar 2025 · Hetzner</span>
          <span class="amt">−0.01820000&nbsp;₿ · −742.18&nbsp;€</span>
        </div>
        <div class="attach">
          <span class="clip" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21.4 11.05 12.25 20.2a5.5 5.5 0 0 1-7.78-7.78l8.49-8.48a3.67 3.67 0 1 1 5.18 5.18l-8.48 8.49a1.83 1.83 0 0 1-2.6-2.6l7.79-7.78"/></svg>
          </span>
          <span class="file">hetzner-invoice-2025-03.pdf</span>
          <span class="download-icon" aria-label="Download">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
          </span>
        </div>
      </div>
    </div>

    <!-- ── 3 · the filing, last ─────────────────────────────── -->
    <div class="msg you" data-at="5">Give me the filing. I want to check the math myself.</div>

    <div class="msg bot" data-at="6">
      <p>Here. Every figure re-derives from a formula you can re-run, and none of it left this machine.</p>

      <div class="card">
        <div class="card-top">
          <span class="card-name">E&nbsp;1kv · calendar year 2025</span>
          <span class="download-icon" aria-label="Download">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
          </span>
        </div>
        <dl class="kv">
          <div><dt>Capital gains</dt><dd>{eur(gains)}&nbsp;€</dd></div>
          <div><dt>Tax due · §&nbsp;27b</dt><dd class="hot">{eur(due)}&nbsp;€</dd></div>
        </dl>
        <div class="card-foot">
          <span class="file">e1kv-2025.xlsx</span>
          <span>16 sheets · every figure re-derivable</span>
        </div>
      </div>
    </div>

    <div class="typing" data-typing aria-hidden="true"><i></i><i></i><i></i></div>
  </div>

  <button class="replay" type="button" data-replay>Replay</button>
</div>

<script>
  const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  for (const chat of document.querySelectorAll<HTMLElement>(".chat")) {
    const log = chat.querySelector<HTMLElement>("[data-log]");
    const typing = chat.querySelector<HTMLElement>("[data-typing]");
    if (!log || !typing) continue;
    const msgs = [...chat.querySelectorAll<HTMLElement>(".msg")];
    let timers: number[] = [];

    const clear = () => {
      timers.forEach((t) => window.clearTimeout(t));
      timers = [];
    };

    const show = (n: number, smooth: boolean) => {
      for (const m of msgs) m.classList.toggle("is-in", Number(m.dataset.at) <= n);
      chat.dataset.turn = String(n);
      // Follow the conversation, the way a chat pane does.
      log.scrollTo({ top: log.scrollHeight, behavior: smooth ? "smooth" : "auto" });
    };

    const play = () => {
      clear();
      show(0, false);
      typing.classList.remove("is-on");
      // A question lands, the agent thinks, then the answer arrives.
      const beats: [number, number, boolean][] = [
        [500, 1, true],
        [1400, 2, false],
        [3200, 3, true],
        [4100, 4, false],
        [6000, 5, true],
        [6900, 6, false],
      ];
      for (const [at, n, isQuestion] of beats) {
        timers.push(
          window.setTimeout(() => {
            show(n, n > 1);
            typing.classList.toggle("is-on", isQuestion);
          }, at),
        );
      }
    };

    chat.querySelector("[data-replay]")?.addEventListener("click", play);

    if (REDUCED) {
      show(6, false);
      continue;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          play();
        }
      },
      { threshold: 0.3 },
    );
    io.observe(chat);
  }
</script>

<style>
  .chat {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: 0 24px 56px -28px rgba(0, 0, 0, 0.75);
    overflow: hidden;
  }

  /* A fixed pane the conversation scrolls inside, so three exchanges cost the
     section no more height than one. */
  .chat-log {
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 452px;
    overflow-y: auto;
    padding: 18px;
    scrollbar-color: rgba(255, 255, 255, 0.14) transparent;
    scrollbar-width: thin;
  }

  .chat-log::-webkit-scrollbar { width: 6px; }

  .chat-log::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.14);
    border-radius: 999px;
  }

  /* ── Messages ─────────────────────────────────────────── */
  /* Not-yet-sent messages take no space at all: the pane has to grow as the
     conversation arrives, otherwise scrolling to the bottom lands past a stack
     of invisible ones and the chat looks empty. */
  .msg { display: none; }

  .msg.is-in {
    display: block;
    animation: msgIn 0.3s ease both;
  }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  .you {
    align-self: flex-end;
    max-width: 84%;
    padding: 9px 13px;
    border-radius: 14px 14px 4px 14px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--fg);
    font-size: 14px;
    line-height: 1.45;
    letter-spacing: -0.005em;
  }

  .bot {
    align-self: flex-start;
    max-width: 96%;
  }

  .bot p {
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--fg-muted);
    margin-bottom: 10px;
  }

  /* ── Answer cards ─────────────────────────────────────── */
  .card {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.02);
    padding: 13px 14px;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 11px;
  }

  .card-name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .download-icon {
    display: grid;
    flex: none;
    width: 22px;
    height: 22px;
    place-items: center;
    color: var(--fg-dim);
  }

  .download-icon svg {
    width: 14px;
    height: 14px;
  }

  .kv > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 5px 0;
  }

  .kv dt {
    font-size: 13px;
    color: var(--fg-dim);
  }

  .kv dd {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .kv dd.hot {
    color: var(--warn);
    font-weight: 500;
  }

  .card-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin-top: 11px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 11.5px;
    color: var(--fg-faint);
  }

  .file {
    font-family: var(--font-mono);
    color: var(--fg-muted);
  }

  /* ── Monthly chart ────────────────────────────────────── */
  .chart-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    font-size: 11px;
    color: var(--fg-dim);
  }

  .chart-head span:first-child {
    color: var(--fg);
    font-weight: 600;
  }

  .spark {
    width: 100%;
    height: auto;
    display: block;
  }

  .grid {
    stroke: rgba(255, 255, 255, 0.055);
    stroke-width: 1;
  }

  .axis {
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 1.5;
  }

  .bar.incoming { fill: oklch(0.56 0.16 150); }
  .bar.outgoing { fill: var(--accent); }
  .bar.transfer { fill: oklch(0.56 0.04 260); }
  .bar.swap { fill: oklch(0.62 0.16 246); }

  .mo {
    font-family: var(--font-mono);
    font-size: 7px;
    fill: var(--fg-faint);
    text-anchor: middle;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin-top: 8px;
    font-size: 12px;
    color: var(--fg-dim);
  }

  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    margin-right: 6px;
  }

  .dot.incoming { background: oklch(0.56 0.16 150); }
  .dot.outgoing { background: var(--accent); }
  .dot.transfer { background: oklch(0.56 0.04 260); }
  .dot.swap { background: oklch(0.62 0.16 246); }

  /* ── Transaction card ─────────────────────────────────── */
  .amt {
    flex: none;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .attach {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 12px;
  }

  .clip {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    flex: none;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--fg-dim);
  }

  .clip svg { width: 12px; height: 12px; }

  .attach .file {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11.5px;
  }

  /* ── Typing indicator ─────────────────────────────────── */
  .typing {
    display: flex;
    gap: 4px;
    align-self: flex-start;
    padding: 2px 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .typing.is-on { opacity: 1; }

  .typing i {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--fg-faint);
    animation: typedot 1.1s ease-in-out infinite;
  }

  .typing i:nth-child(2) { animation-delay: 0.15s; }
  .typing i:nth-child(3) { animation-delay: 0.3s; }

  @keyframes typedot {
    0%, 60%, 100% { opacity: 0.25; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-2px); }
  }

  /* ── Replay ───────────────────────────────────────────── */
  .replay {
    position: absolute;
    top: 10px;
    right: 12px;
    font-size: 11px;
    color: var(--fg-faint);
    padding: 4px 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-card) 92%, transparent);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.25s ease, color 0.18s ease;
  }

  .replay:hover { color: var(--fg); }

  [data-turn="6"] .replay { opacity: 1; }

  @media (max-width: 820px) {
    .chat-log {
      height: 420px;
      overflow-y: hidden;
      padding: 14px;
    }
  }
</style>
