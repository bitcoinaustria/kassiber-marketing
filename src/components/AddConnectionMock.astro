const FIRST = "descriptor";
---

<div class="conn-mock" data-conn-mock data-tab="wallets">
  <div class="conn-head">
    <div class="conn-title">Add connection</div>
    <div class="conn-sub">Choose a watch-only wallet, node, exchange, or local file source.</div>
    <span class="conn-close" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
    </span>
  </div>

  <div class="conn-body">
    <nav class="conn-rail" aria-label="Source categories">
      {CATEGORIES.map((category, index) => (
        <button class="conn-cat" type="button" data-cat-btn={category.id} aria-pressed={index === 0 ? "true" : "false"}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={category.icon} />
          <span>{category.label}</span>
        </button>
      ))}
    </nav>

    <div class="conn-main">
      <label class="conn-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34" /><circle cx="11" cy="11" r="8" /></svg>
        <input
          type="search"
          data-conn-search
          placeholder="Search sources (e.g. river, descriptor, btcpay)…"
          aria-label="Search sources (e.g. river, descriptor, btcpay)…"
          autocomplete="off"
          spellcheck="false"
        />
      </label>

      <div class="conn-list" data-conn-list>
        {SOURCES.map((source) => (
          <button
            class="conn-row"
            type="button"
            data-source={source.id}
            data-category={source.category}
            data-haystack={`${source.title} ${source.description} ${source.id}`.toLowerCase()}
            aria-pressed={source.id === FIRST ? "true" : "false"}
            title={source.description}
            hidden={source.category !== "wallets"}
          >
            <span
              class:list={["conn-art", { "conn-art--tile": !!source.tile }]}
              style={source.frame ? `background:${source.frame}` : undefined}
              aria-hidden="true"
            >
              {source.logo ? (
                <img src={source.logo} alt="" class:list={{ "is-inverted": source.invert }} loading="lazy" decoding="async" />
              ) : (
                <span class="conn-tile" style={`background:${source.tile?.bg};color:${source.tile?.fg}`}>{source.tile?.label}</span>
              )}
            </span>
            <span class="conn-row-title">{source.title}</span>
            {source.planned && <span class="conn-badge">Planned</span>}
            <span class="conn-row-format">{source.formatLabel ?? source.pathLabel}</span>
          </button>
        ))}
        <p class="conn-empty" data-conn-empty hidden>No sources match that search.</p>
      </div>
    </div>

    <div class="conn-detail" aria-live="polite">
      {SOURCES.map((source) => (
        <div class="conn-pane" data-pane={source.id} hidden={source.id !== FIRST}>
          <div class="conn-pane-head">
            <span
              class:list={["conn-art", "conn-art--lg", { "conn-art--tile": !!source.tile }]}
              style={source.frame ? `background:${source.frame}` : undefined}
              aria-hidden="true"
            >
              {source.logo ? (
                <img src={source.logo} alt="" class:list={{ "is-inverted": source.invert }} loading="lazy" decoding="async" />
              ) : (
                <span class="conn-tile" style={`background:${source.tile?.bg};color:${source.tile?.fg}`}>{source.tile?.label}</span>
              )}
            </span>
            <span class="conn-pane-id">
              <span class="conn-pane-title">{source.title}</span>
              <span class="conn-pane-path">{source.pathLabel}{source.formatLabel ? ` · ${source.formatLabel}` : ""}</span>
            </span>
          </div>
          {(source.planned || source.docs) && (
            <div class="conn-pane-badges">
              {source.planned && <span class="conn-badge">Planned</span>}
              {source.docs && <a class="conn-docs" href={source.docs} target="_blank" rel="noopener noreferrer">Docs</a>}
            </div>
          )}
          <p class="conn-pane-desc">{source.description}</p>
          <ul class="conn-pane-details">
            {source.details.map((detail) => <li>{detail}</li>)}
          </ul>
          <p class="conn-pane-note">Third-party marks belong to their owners; shown to identify sources, with no affiliation implied.</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Illustration, not a control surface: nothing here takes a click. -->
  <div class="conn-foot" aria-hidden="true">
    <span class="conn-btn">Cancel</span>
    <span class="conn-btn">Continue</span>
  </div>
</div>

<script>
  for (const mock of document.querySelectorAll<HTMLElement>("[data-conn-mock]")) {
    const categories = [...mock.querySelectorAll<HTMLButtonElement>("[data-cat-btn]")];
    const rows = [...mock.querySelectorAll<HTMLButtonElement>("[data-source]")];
    const panes = [...mock.querySelectorAll<HTMLElement>("[data-pane]")];
    const list = mock.querySelector<HTMLElement>("[data-conn-list]");
    const search = mock.querySelector<HTMLInputElement>("[data-conn-search]");
    const empty = mock.querySelector<HTMLElement>("[data-conn-empty]");
    let category = "wallets";

    const select = (id: string) => {
      for (const row of rows) row.setAttribute("aria-pressed", String(row.dataset.source === id));
      for (const pane of panes) pane.hidden = pane.dataset.pane !== id;
    };

    // As in the app: a query searches every category, and the rail shows no
    // current category while it does.
    const render = () => {
      const query = search?.value.trim().toLowerCase() ?? "";
      let shown = 0;
      for (const row of rows) {
        const match = query ? (row.dataset.haystack ?? "").includes(query) : row.dataset.category === category;
        row.hidden = !match;
        if (match) shown += 1;
      }
      if (empty) empty.hidden = shown > 0;
      for (const button of categories) {
        button.setAttribute("aria-pressed", String(!query && button.dataset.catBtn === category));
      }
    };

    for (const button of categories) {
      button.addEventListener("click", () => {
        category = button.dataset.catBtn ?? "wallets";
        if (search) search.value = "";
        render();
        // The category's first listed source, like reopening the dialog on it.
        const first = rows.find((row) => !row.hidden);
        if (first) select(first.dataset.source ?? "");
        list?.scrollTo(0, 0);
      });
    }

    for (const row of rows) {
      row.addEventListener("click", () => select(row.dataset.source ?? ""));
    }

    search?.addEventListener("input", () => {
      render();
      list?.scrollTo(0, 0);
    });
  }
</script>

