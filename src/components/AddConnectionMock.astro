type Category = "wallets" | "nodes" | "lightning" | "merchant" | "exchanges" | "files";
type Source = {
  id: string;
  title: string;
  description: string;
  category: Category;
  logo?: string;
  tile?: Tile;
  invert?: boolean;
  frame?: string;
  planned?: boolean;
  pathLabel: string;
  formatLabel?: string;
  docs?: string;
  details: string[];
};

