---
import ModelPickerMock from "./ModelPickerMock.astro";

/*
 * Static mock of Kassiber's assistant composer, ported from the app's
 * ui-tauri/src/components/ai-02.tsx + components/ai/ProviderModelPicker.tsx.
 *
 * Shown in the focus-within state: the app puts a brand-red outline on the
 * whole surface (not the textarea's own ring) so the outline does not cut
 * through the model/send row. Values below are the app's dark-theme tokens
 * copied literally rather than remapped to the marketing palette, so the panel
 * reads as part of the screenshot it floats on.
 *
 * The picker is a real disclosure so its open/close behavior matches the app;
 * the model rows themselves remain a visual mock.
 */
---

<div class="hero-chat">
  <div class="hero-chat-dock">
    <div class="hero-chat-surface">
      <div class="hero-chat-input" aria-hidden="true">
        <span class="hero-chat-caret"></span><span class="hero-chat-placeholder">Ask anything</span>
      </div>

      <div class="hero-chat-bar">
      <span class="hero-chat-icon-btn" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
      </span>

      <details class="hero-chat-picker">
        <summary class="hero-chat-model">
          <svg class="hero-chat-model-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="16" height="16" x="4" y="4" rx="2" /><rect width="6" height="6" x="9" y="9" rx="1" /><path d="M15 2v2" /><path d="M15 20v2" /><path d="M2 15h2" /><path d="M2 9h2" /><path d="M20 15h2" /><path d="M20 9h2" /><path d="M9 2v2" /><path d="M9 20v2" /></svg>
          <span class="hero-chat-model-label">omlx · Qwen3.6-35B-A3B-4bit</span>
          <svg class="hero-chat-model-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="hero-chat-pop">
          <ModelPickerMock />
        </div>
      </details>

      <span class="hero-chat-send" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7" /><path d="M12 19V5" /></svg>
      </span>
      </div>
    </div>
  </div>
</div>

<script>
  const pickers = document.querySelectorAll<HTMLDetailsElement>(".hero-chat-picker");

  document.addEventListener("pointerdown", (event) => {
    for (const picker of pickers) {
      if (picker.open && (!(event.target instanceof Node) || !picker.contains(event.target))) {
        picker.open = false;
      }
    }
  });
</script>

<style>
  /*
   * Sits where the app docks it: bottom-right of the window, inset by the same
   * ~2% the real composer clears.
   *
   * Everything inside is sized in em, so font-size alone scales the whole
   * panel. 0.86cqw is true to the app's own scale in this screenshot; --zoom
   * takes it deliberately larger so the model name reads as a hero element.
   * Pure cqw with no clamp, so the panel and the screenshot behind it scale by
   * exactly the same factor at every width.
   */
  .hero-chat {
    --zoom: 1.75;

    /*
     * Scroll-driven dock. The composer's resting place is below the fold, so it
     * starts lifted by --dock-travel, holds that on-screen position while the
     * page scrolls under it, then settles into the spot the app really docks it.
     *
     * The trick is that the animation range and the translate distance are the
     * same length: over those pixels of scroll the element moves down the
     * document at exactly the rate the document moves up, so it looks pinned to
     * the viewport, then simply stops.
     *
     * --dock-travel is how far the resting position sits below the fold. It
     * tracks viewport height (the shorter the window, the further it has to
     * travel) and clamps to 0 on tall windows, where the dock is already in the
     * first view and nothing should move. The 1460px is the resting bottom edge
     * at desktop widths, measured; the fluid h1 makes it drift a little with
     * width, so it is biased to overshoot — floating slightly high is harmless,
     * starting below the fold defeats the point.
     */
    --dock-travel: clamp(0px, calc(1460px - 100vh), 620px);

    position: absolute;
    /* Deliberately past the screenshot's right edge so it reads as floating
       over the page rather than living inside the window. */
    right: -3%;
    bottom: 2.6%;
    width: calc(29% * var(--zoom));
    z-index: 2;
    font-size: calc(0.86cqw * var(--zoom));
    line-height: 1;
    pointer-events: none;
    /* Firefox needs a non-zero duration for scroll-driven animations. */
    animation: heroChatDock 1ms linear both;
    animation-timeline: scroll(root block);
    animation-range: 0 var(--dock-travel);
  }

  @supports not (animation-timeline: scroll(root block)) {
    .hero-chat {
      animation: none;
      transform: translateY(0);
    }
  }

  @keyframes heroChatDock {
    from {
      transform: translateY(calc(-1 * var(--dock-travel)));
    }
    to {
      transform: translateY(0);
    }
  }

  /*
   * The picker, as a real disclosure. <details>/<summary> gives open/close and
   * keyboard support with no JavaScript; the chip is the summary, so the popover
   * anchors to it the way side="top" align="start" does in the app.
   *
   * The rows inside do not respond to clicks — this is a mock of the panel, not
   * a working picker.
   */
  .hero-chat-picker {
    position: relative;
    min-width: 0;
    flex: 1;
    /* The panel as a whole is inert; this is the one part meant to be used. */
    pointer-events: auto;
  }

  .hero-chat-picker summary {
    list-style: none;
    cursor: pointer;
  }

  .hero-chat-picker summary::-webkit-details-marker {
    display: none;
  }

  .hero-chat-picker summary:focus-visible {
    outline: 2px solid color-mix(in srgb, #ff3341 70%, transparent);
    outline-offset: 3px;
    border-radius: 0.4em;
  }

  .hero-chat-picker[open] .hero-chat-model-chevron {
    transform: rotate(180deg);
  }

  /*
   * The popover keeps the app's own scale rather than following --zoom: it is a
   * real panel of controls, and blowing it up with the composer made it read as
   * a graphic. So it sizes itself (14.4px root, 34rem wide) and only the offset
   * from the chip is expressed in the composer's em.
   */
  .hero-chat-pop {
    position: absolute;
    bottom: calc(100% + 0.55em);
    left: 0;
    width: calc(34 * 14.4px); /* the panel's own w-34rem at the app root */
    max-width: 78vw;
    animation: heroPickerOpen 0.16s ease-out;
  }

  @keyframes heroPickerOpen {
    from {
      opacity: 0;
      transform: translateY(0.5em) scale(0.98);
    }
  }

  /*
   * AssistantDock's outer card (components/kb/AssistantDock.tsx): rounded-3xl
   * p-2 over border-border/70 bg-card/95, dark:border-white/10 dark:bg-card/90.
   * Verified in the capture: outside the red ring the pixels step to (22,22,22)
   * — --card at 90% over the app background — with a (45,45,45) hairline, which
   * is white at 10% over that fill.
   */
  .hero-chat-dock {
    position: relative;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: 1.5em; /* rounded-3xl */
    padding: 0.5em; /* p-2 */
    background: oklch(0.205 0 0 / 0.9); /* dark bg-card/90 */
    box-shadow: 0 20px 48px -22px rgb(0 0 0 / 65%);
    transform: perspective(2000px) rotateX(2deg);
    transform-origin: 78% 100%;
    transition: transform 0.6s ease, box-shadow 0.6s ease;
    will-change: transform;
  }

  /* The composer occupies a separate plane from the app capture behind it.
     Giving each its own hover target makes the stack feel layered, not fused. */
  @media (hover: hover) and (pointer: fine) {
    .hero-chat {
      pointer-events: auto;
    }

    .hero-chat:hover .hero-chat-dock {
      transform: perspective(2000px) translateY(-10px) rotateX(0deg) rotateY(-1deg) scale(1.0125);
      box-shadow: 0 28px 58px -22px rgb(0 0 0 / 78%);
    }
  }

  /* App tokens (dark theme), copied from ui-tauri/src/styles/globals.css. */
  .hero-chat-surface {
    --app-card: oklch(0.205 0 0);
    --app-fg: oklch(0.985 0 0);
    --app-muted-fg: oklch(0.708 0 0);
    /* --ring: var(--kb-accent); dark --kb-accent: #ff3341 */
    --app-ring: #ff3341;

    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 4.5em; /* min-h-[72px] */
    border-radius: 1.375em; /* rounded-[22px] */
    /* The dock passes inputPanelElevated={false}, so the composer drops the
       glass shadow and takes a flat bg-muted fill instead. */
    /* focus-within:outline-2 outline-offset-2 outline-ring/55 */
    outline: 2px solid color-mix(in srgb, var(--app-ring) 55%, transparent);
    outline-offset: 2px;
  }

  /*
   * .kb-composer-glass::before — the frosted fill.
   *
   * The app composes this from --card at --glass-opacity over a live backdrop
   * blur, because a chat thread scrolls under it. Over a flat screenshot that
   * chain resolves to one colour, and the frame's containment stops
   * backdrop-filter from sampling anything anyway, so this is the measured
   * result: #262626, sampled flat across the composer in the app capture.
   * Opaque matters — the placeholder and label colours below are alpha values
   * that only land on the app's tones when they composite over this exact fill.
   */
  .hero-chat-surface::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: #262626;
  }

  /* Textarea row: px-4 pt-4 pb-1, text-base. */
  .hero-chat-input {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex: 1;
    padding: 1em 1em 0.25em;
    font-size: 1em;
  }

  .hero-chat-placeholder {
    /* placeholder:text-muted-foreground/45 */
    color: color-mix(in srgb, var(--app-muted-fg) 45%, transparent);
    white-space: nowrap;
  }

  .hero-chat-caret {
    width: 1px;
    height: 1.15em;
    margin-right: 0.12em;
    background: var(--app-fg);
    animation: heroChatBlink 1.1s steps(2) infinite;
  }

  /* Toolbar row: px-2 pb-2 min-h-[42px] gap-2. */
  .hero-chat-bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5em;
    min-height: 2.625em;
    padding: 0 0.5em 0.5em;
  }

  /* Attachment button: size-8 rounded-full text-muted-foreground. */
  .hero-chat-icon-btn {
    flex: none;
    display: grid;
    place-items: center;
    width: 2em;
    height: 2em;
    border-radius: 999px;
    color: var(--app-muted-fg);
  }

  .hero-chat-icon-btn svg {
    width: 1em;
    height: 1em;
  }

  /* Picker trigger: gap-1.5 rounded-full text-sm text-muted-foreground. */
  .hero-chat-model {
    display: flex;
    align-items: center;
    gap: 0.375em;
    min-width: 0;
    font-size: 0.875em;
    color: var(--app-muted-fg);
    transition: color 0.18s ease;
  }

  .hero-chat-picker summary:hover .hero-chat-model-label,
  .hero-chat-picker[open] .hero-chat-model {
    color: var(--app-fg);
  }

  .hero-chat-model-mark {
    flex: none;
    width: 1.143em; /* size-4 against the 0.875em context */
    height: 1.143em;
  }

  .hero-chat-model-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-chat-model-chevron {
    flex: none;
    width: 1em;
    height: 1em;
    opacity: 0.7;
    transition: transform 0.18s ease;
  }

  /*
   * Send button, disabled: the field is empty, so canSubmit is false and the
   * app renders disabled:bg-muted disabled:text-muted-foreground plus the
   * Button base's disabled:opacity-50 — not the filled bg-foreground pill.
   * --muted sits within a shade of the panel fill, so no circle reads at all;
   * measured arrow is #636363, which is muted-foreground at 50% over #262626.
   */
  .hero-chat-send {
    flex: none;
    display: grid;
    place-items: center;
    margin-left: auto;
    width: 2em;
    height: 2em;
    border-radius: 999px;
    background: oklch(0.269 0 0); /* dark --muted */
    color: var(--app-muted-fg);
    opacity: 0.5;
  }

  .hero-chat-send svg {
    width: 1em;
    height: 1em;
  }

  @keyframes heroChatBlink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-chat,
    .hero-chat-caret {
      animation: none;
    }

    .hero-chat-dock {
      transform: none !important;
      transition: opacity 0.2s ease;
    }
  }

  /*
   * Mobile: the screenshot is hidden at this width, so the composer stops being
   * an overlay and becomes the hero's visual on its own. Sized in vw rather
   * than cqw — there is no screenshot left to stay proportional to, and the
   * point here is that it reads at a real, touchable size.
   */
  @media (max-width: 820px) {
    .hero-chat {
      position: static;
      width: 100%;
      max-width: 420px;
      margin: 4px auto 0;
      font-size: clamp(13px, 4vw, 16px);
      /* Nothing to dock into at this width, and it already sits in the first
         view, so the scroll travel is off. */
      animation: none;
      transform: none;
    }

    /* Dropping position:relative lets the popover resolve against the composer
       surface instead of the chip, so a chip-anchored panel cannot run off the
       right edge of a phone. */
    .hero-chat-picker {
      position: static;
    }

    .hero-chat-pop {
      --mpm-size: 11px;
      left: 0;
      right: 0;
      width: auto;
      max-width: none;
    }

    /* Off a screenshot it needs its own depth, plus a red bloom so the focus
       state reads as deliberate rather than as an error. */
    .hero-chat-surface {
      box-shadow:
        0 0 0 1px rgb(255 255 255 / 8%),
        0 18px 40px -22px rgb(0 0 0 / 90%),
        0 0 32px -8px color-mix(in srgb, var(--app-ring) 22%, transparent);
    }

    /* One row on a phone: the full model id would crowd the send button. */
    .hero-chat-model-label {
      font-variant-numeric: tabular-nums;
    }
  }

  @media (max-width: 400px) {
    .hero-chat-model-label {
      /* Keeps "omlx · Qwen3.6-35B" and drops the quantisation suffix. */
      font-size: 0.94em;
    }
  }
</style>
