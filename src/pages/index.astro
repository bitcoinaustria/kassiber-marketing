  <!-- Native <details>: no JS, no dependency, animated via ::details-content. -->
  <section id="faq" class="sec-faq">
    <div class="container">
      <div class="section-head faq-head">
        <div class="eyebrow">FAQ</div>
        <h2>Before you ask.</h2>
      </div>

      <div class="faq-list">
        <details class="faq-item">
          <summary>Can I try it without connecting my own wallets?</summary>
          <p>
            Yes, if you have Docker. One script spins up a throwaway regtest
            network and seeds complete demo books: thirteen wallets, Lightning
            channels, Liquid, a BTCPay store, and years of activity to
            reconcile. One command brings it up, one tears it down and deletes
            every trace. None of it touches mainnet and none of it is your
            data.
          </p>
        </details>

        <details class="faq-item">
          <summary>Do I need to run my own node?</summary>
          <p>
            No. Kassiber ships with default backends and syncs the moment you
            install it. But any backend you don't run yourself learns which
            addresses you ask about and when, so when that matters, point it at
            your own Bitcoin Core, Electrum, or Esplora. Each backend can also
            be routed through a Tor proxy you provide.
          </p>
        </details>

        <details class="faq-item">
          <summary>Does Kassiber replace my tax advisor?</summary>
          <p>
            No, and it is not built to. It computes the numbers and shows its
            work, so you or your advisor can check every figure instead of
            trusting ours. What you file stays your responsibility, Kassiber is
            pre-alpha software provided without warranty, and nothing it outputs
            is tax or legal advice. If your situation is unusual, pay a
            professional and hand them the export.
          </p>
        </details>

        <details class="faq-item">
          <summary>What happens if I lose my passphrase?</summary>
          <p>
            Your books stay encrypted and nobody opens them again, including us.
            The passphrase is the whole perimeter and there is no recovery path.
            Keep it wherever you keep your seed backups.
          </p>
        </details>

        <details class="faq-item">
          <summary>Can Kassiber spend my coins?</summary>
          <p>
            No. It never holds spending keys and only ever reads descriptors and
            watch-only addresses. The worst case is a wrong number in a report,
            not a missing coin.
          </p>
        </details>

        <details class="faq-item">
          <summary>I'm not in Austria. Is it still useful?</summary>
          <p>
            Yes, with one caveat. The books, the accounting standards, and the
            exports work anywhere. The ready-made filing reports are Austrian
            for now; everywhere else gets the generic reports, and
            country-specific ones ship on request.
          </p>
        </details>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string; arch?: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) {
      return { os: "mac", label: "Download for macOS", arch: "arm64" };
    }
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      const preferred = assets.find((a) => a.name.endsWith(`-${platform.arch}.dmg`));
      const fallback = assets.find((a) => a.name.endsWith(".dmg"));
      return (preferred ?? fallback)?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith(".AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  async function init() {
    const btn = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const label = document.getElementById("download-label");
    const ctaBtn = document.getElementById("cta-download-btn") as HTMLAnchorElement | null;
    const ctaLabel = document.getElementById("cta-download-label");

    const platform = detectPlatform();
    if (!platform) return;
    document.documentElement.dataset.platform = platform.os;
    if (label) label.textContent = platform.label;
    if (ctaLabel) ctaLabel.textContent = platform.label;

    try {
      const release = await fetchLatestRelease();
      const url = pickAsset(release.assets ?? [], platform);
      if (url) {
        if (btn) {
          btn.href = url;
          btn.removeAttribute("target");
          btn.removeAttribute("rel");
        }
        if (ctaBtn) {
          ctaBtn.href = url;
          ctaBtn.removeAttribute("target");
          ctaBtn.removeAttribute("rel");
        }
      }
    } catch {
      if (btn) btn.href = RELEASES_URL;
      if (ctaBtn) ctaBtn.href = RELEASES_URL;
    }
  }

  init();
</script>

<script>
  // Ambient network between the floating hero cards: pulses fire between
  // random card pairs, in random directions, on random timing. Lines exist
  // only while a transfer is in flight; the receiving card glows briefly.
  const NS = "http://www.w3.org/2000/svg";

  const COLOR: Record<string, string> = {
    "hf-bitcoin": "#f7931a",
    "hf-lightning": "#8b5cf6",
    "hf-opencode": "#9ca3af",
    "hf-liquid": "#22e1c9",
    "hf-btcpay": "#51b13e",
  };

  let uid = 0;

  function el(tag: string, attrs: Record<string, string>) {
    const node = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
    return node;
  }

  function center(mark: Element, origin: DOMRect) {
    const r = mark.getBoundingClientRect();
    return { x: r.left - origin.left + r.width / 2, y: r.top - origin.top + r.height / 2 };
  }

  function colorOf(mark: Element) {
    const cls = [...mark.classList].find((c) => c.startsWith("hf-"));
    return (cls && COLOR[cls]) || "#9ca3af";
  }

  function glow(mark: Element, ms: number) {
    mark.animate(
      [{ filter: "brightness(1)" }, { filter: "brightness(1.25)" }, { filter: "brightness(1)" }],
      { duration: ms, easing: "ease-in-out" },
    );
  }

  function visibleMarks(hero: HTMLElement) {
    return [...hero.querySelectorAll(".hero-float-mark")].filter(
      (m) => getComputedStyle(m).display !== "none",
    );
  }

  // Value moves between the real Bitcoin connections. OpenCode is the
  // observer — it only ever polls them (see report/query below).
  function fire(hero: HTMLElement, svg: SVGSVGElement) {
    const marks = visibleMarks(hero).filter((m) => !m.classList.contains("hf-opencode"));
    if (marks.length < 2) return;

    const i = Math.floor(Math.random() * marks.length);
    let j = Math.floor(Math.random() * (marks.length - 1));
    if (j >= i) j++;
    transfer(hero, svg, marks[i], marks[j]);
  }

  // OpenCode is an LLM agent: it polls one or two connections per round.
  // Outbound query only — a dashed line marches out to the card and the card
  // glows in acknowledgment. Nothing that looks like value flows back in.
  function report(hero: HTMLElement, svg: SVGSVGElement) {
    const oc = hero.querySelector<HTMLElement>(".hf-opencode");
    if (!oc || getComputedStyle(oc).display === "none") return;
    const others = visibleMarks(hero)
      .filter((m) => m !== oc)
      .sort(() => Math.random() - 0.5);
    const n = Math.random() < 0.4 ? 2 : 1;
    others.slice(0, n).forEach((m, k) => setTimeout(() => query(hero, svg, oc, m), k * 2000));
  }

  function query(hero: HTMLElement, svg: SVGSVGElement, oc: Element, target: Element) {
    const origin = hero.getBoundingClientRect();
    const p1 = center(oc, origin);
    const p2 = center(target, origin);
    const bow = (0.06 + Math.random() * 0.1) * (Math.random() < 0.5 ? -1 : 1);
    const d = `M ${p1.x} ${p1.y} Q ${(p1.x + p2.x) / 2 - (p2.y - p1.y) * bow} ${(p1.y + p2.y) / 2 + (p2.x - p1.x) * bow} ${p2.x} ${p2.y}`;

    const c = colorOf(target);
    const ask = el("path", { class: "hl-ask", d, stroke: c, style: `--glow: ${c}` });
    svg.appendChild(ask);
    const askDur = 700;
    ask.animate(
      [
        { opacity: 0, strokeDashoffset: 44 },
        { opacity: 0.5, strokeDashoffset: 22, offset: 0.3 },
        { opacity: 0.23, strokeDashoffset: 0, offset: 0.7 },
        { opacity: 0, strokeDashoffset: -12 },
      ],
      { duration: askDur + 600, easing: "linear" },
    );
    setTimeout(() => glow(target, 900), askDur * 0.7);
    setTimeout(() => ask.remove(), askDur + 700);
  }

  function transfer(hero: HTMLElement, svg: SVGSVGElement, a: Element, b: Element) {
    const origin = hero.getBoundingClientRect();
    const p1 = center(a, origin);
    const p2 = center(b, origin);
    const dx = p2.x - p1.x;
    const dy = p2.y - p1.y;
    const bow = (0.08 + Math.random() * 0.22) * (Math.random() < 0.5 ? -1 : 1);

    // Lightning transfers get a subtly jagged bolt path; everything else arcs.
    const isLightning =
      a.classList.contains("hf-lightning") || b.classList.contains("hf-lightning");
    let d: string;
    if (isLightning) {
      const dist = Math.hypot(dx, dy);
      const segs = Math.max(4, Math.round(dist / 90));
      const pts = [`M ${p1.x} ${p1.y}`];
      for (let s = 1; s < segs; s++) {
        const t = s / segs;
        // point on the same quadratic arc, plus perpendicular jitter
        const qx = (1 - t) ** 2 * p1.x + 2 * (1 - t) * t * ((p1.x + p2.x) / 2 - dy * bow) + t ** 2 * p2.x;
        const qy = (1 - t) ** 2 * p1.y + 2 * (1 - t) * t * ((p1.y + p2.y) / 2 + dx * bow) + t ** 2 * p2.y;
        const jitter = (Math.random() - 0.5) * 16;
        pts.push(`L ${qx - (dy / dist) * jitter} ${qy + (dx / dist) * jitter}`);
      }
      pts.push(`L ${p2.x} ${p2.y}`);
      d = pts.join(" ");
    } else {
      d = `M ${p1.x} ${p1.y} Q ${(p1.x + p2.x) / 2 - dy * bow} ${(p1.y + p2.y) / 2 + dx * bow} ${p2.x} ${p2.y}`;
    }

    const ca = colorOf(a);
    const cb = colorOf(b);
    const id = `hl-${uid++}`;
    const grad = el("linearGradient", {
      id,
      gradientUnits: "userSpaceOnUse",
      x1: String(p1.x), y1: String(p1.y), x2: String(p2.x), y2: String(p2.y),
    });
    grad.appendChild(el("stop", { offset: "0", "stop-color": ca }));
    grad.appendChild(el("stop", { offset: "1", "stop-color": cb }));
    svg.appendChild(grad);

    // Lightning is fast — that's the whole point.
    const dur = isLightning ? 600 + Math.random() * 300 : 1500 + Math.random() * 900;
    const dispose = (ms: number, ...nodes: Element[]) =>
      setTimeout(() => nodes.forEach((n) => n.remove()), ms);

    // Faint context line. Bolts flicker like a discharge; arcs snap in and
    // decay slowly like an afterglow.
    const base = el("path", { class: "hl-line", d, stroke: `url(#${id})`, style: `--glow: ${cb}` });
    svg.appendChild(base);
    base.animate(
      isLightning
        ? [
            { opacity: 0 },
            { opacity: 0.69, offset: 0.06 },
            { opacity: 0.15, offset: 0.14 },
            { opacity: 0.56, offset: 0.24 },
            { opacity: 0.38, offset: 0.5 },
            { opacity: 0 },
          ]
        : [
            { opacity: 0 },
            { opacity: 0.44, offset: 0.12 },
            { opacity: 0.31, offset: 0.55 },
            { opacity: 0 },
          ],
      { duration: dur + 400, easing: "linear" },
    );

    const dot = el("circle", { class: "hl-dot", r: "4.5", fill: cb, style: `--glow: ${cb}` });
    svg.appendChild(dot);
    glow(a, 700);
    const len = (base as SVGPathElement).getTotalLength();
    const t0 = performance.now();
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
    const step = (now: number) => {
      const t = Math.min(1, (now - t0) / dur);
      const p = (base as SVGPathElement).getPointAtLength(ease(t) * len);
      dot.setAttribute("cx", String(p.x));
      dot.setAttribute("cy", String(p.y));
      dot.setAttribute("opacity", String(Math.min(1, 6 * Math.min(t, 1 - t))));
      if (t < 1) requestAnimationFrame(step);
      else glow(b, 700);
    };
    requestAnimationFrame(step);
    dispose(dur + 400, grad, base, dot);
  }

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>(".hero").forEach((hero) => {
      const svg = hero.querySelector<SVGSVGElement>(".hero-links");
      if (!svg) return;
      // Fire only while the hero is on screen.
      let visible = false;
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
      }).observe(hero);
      const tick = () => {
        // Roughly every fifth event is an OpenCode poll round.
        if (visible) (Math.random() < 0.2 ? report : fire)(hero, svg);
        setTimeout(tick, 800 + Math.random() * 1600);
      };
      setTimeout(tick, Math.random() * 1200);
    });
  }
</script>

