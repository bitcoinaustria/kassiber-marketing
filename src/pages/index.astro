  <!-- Native <details>: no JS, no dependency, animated via ::details-content.
       A shared name makes them an exclusive accordion, so opening one closes
       the rest. Browsers without it just allow more than one open at a time. -->
  <section id="faq" class="sec-faq">
    <div class="container">
      <div class="section-head faq-head">
        <h2>Before you ask.</h2>
      </div>

      <div class="faq-list">
        <details class="faq-item" name="faq">
          <summary>Can I try it without connecting my own wallets?</summary>
          <p>
            Yes, if you have Docker. The regtest script starts a disposable
            network with thirteen wallets, Lightning channels, Liquid, a
            BTCPay store, and years of activity. The teardown command deletes
            the demo data. It never touches mainnet or your wallets.
          </p>
        </details>

        <details class="faq-item" name="faq">
          <summary>Do I need to run my own node?</summary>
          <p>
            No. Kassiber syncs through default backends after installation.
            Those services can see the addresses you query, so use your own
            Bitcoin Core, Electrum, or Esplora when that matters. You can route
            each backend through your Tor proxy.
          </p>
        </details>

        <details class="faq-item" name="faq">
          <summary>I've switched wallets over the years. Can Kassiber follow?</summary>
          <p>
            Yes. Import each wallet's export, even ones you retired long ago.
            Kassiber pairs the migrations as transfers, so history and cost
            basis stay continuous across every wallet you have used.
          </p>
        </details>

        <details class="faq-item" name="faq">
          <summary>Does Kassiber replace my tax advisor?</summary>
          <p>
            No. Kassiber computes the numbers and exposes each calculation for
            you or your advisor to check. You remain responsible for filing.
            Kassiber is pre-alpha software and provides no tax or legal advice.
            Ask a professional about unusual cases.
          </p>
        </details>

        <details class="faq-item" name="faq">
          <summary>Are my books encrypted?</summary>
          <p>
            Yes, when you set a passphrase. The database is encrypted with
            SQLCipher; only your passphrase opens it.
          </p>
        </details>

        <details class="faq-item" name="faq">
          <summary>What happens if I lose my passphrase?</summary>
          <p>
            Kassiber cannot recover your passphrase. Lose it and the encrypted
            books stay locked, so store it with your seed backups.
          </p>
        </details>

        <details class="faq-item" name="faq">
          <summary>Can Kassiber spend my coins?</summary>
          <p>
            No. Kassiber reads descriptors and watch-only addresses; it never
            holds spending keys. Connected agents can inspect the book. They
            cannot sign or broadcast transactions.
          </p>
        </details>

        <details class="faq-item" name="faq">
          <summary>What does it cost?</summary>
          <p>
            Nothing. Kassiber is free and AGPL-3.0 licensed, built by{" "}
            <a href="https://bitcoin-austria.at" target="_blank" rel="noopener noreferrer">Bitcoin Austria</a>,
            a nonprofit based in Austria. There is no paid tier and nothing
            to upsell.
          </p>
        </details>

        <details class="faq-item" name="faq">
          <summary>Why does my OS warn me about the download?</summary>
          <p>
            Pre-alpha builds are not yet code-signed, so macOS and Windows
            warn on first launch. The source is public if you would rather
            build it yourself.
          </p>
        </details>

        <details class="faq-item" name="faq">
          <summary>What role do AI agents play?</summary>
          <p>
            Kassiber is built by humans and AI agents. Both are welcome to
            contribute. Code changes are reviewed by multiple LLMs before
            they land. Don't trust; audit.
          </p>
        </details>

        <details class="faq-item" name="faq">
          <summary>I'm not in Austria. Is it still useful?</summary>
          <p>
            Yes. Kassiber's books and generic exports work anywhere. The
            included filing preset covers Austria. Other jurisdictions can use
            generic reports or add a country ruleset.
          </p>
        </details>
      </div>
    </div>
  </section>
</Layout>

<script>
  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  function init() {
    const label = document.getElementById("download-label");
    const ctaLabel = document.getElementById("cta-download-label");

    const platform = detectPlatform();
    if (!platform) return;
    document.documentElement.dataset.platform = platform.os;
    if (label) label.textContent = platform.label;
    if (ctaLabel) ctaLabel.textContent = platform.label;
  }

  init();
</script>

<script>
  // Screenshots: on desktop the section is a tall scroll runway with a
  // sticky viewport; vertical progress through it maps 1:1 onto the strip's
  // horizontal scroll. Below 961px or with reduced motion the section keeps
  // its natural height and the strip stays a plain swipeable filmstrip.
  const screensSec = document.getElementById("screens");
  const screensStrip = screensSec?.querySelector<HTMLElement>(".screens-strip");
  const screensMq = window.matchMedia(
    "(min-width: 961px) and (prefers-reduced-motion: no-preference)",
  );

  if (screensSec && screensStrip) {
    let screensRaf = 0;
    let screensOverflow = 0;

    const screensLayout = () => {
      if (!screensMq.matches) {
        screensOverflow = 0;
        screensSec.style.height = "";
        return;
      }
      // Runway = one viewport plus the horizontal distance to cover, so the
      // scroll feels 1:1 and the pin releases exactly at the last slide.
      screensOverflow = screensStrip.scrollWidth - screensStrip.clientWidth;
      screensSec.style.height = `${window.innerHeight + screensOverflow}px`;
    };

    const screensDrive = () => {
      if (!screensMq.matches || screensOverflow <= 0) return;
      cancelAnimationFrame(screensRaf);
      screensRaf = requestAnimationFrame(() => {
        const y = Math.min(
          Math.max(-screensSec.getBoundingClientRect().top, 0),
          screensOverflow,
        );
        screensStrip.scrollLeft = y;
      });
    };

    const screensRelayout = () => {
      screensLayout();
      screensDrive();
    };

    window.addEventListener("scroll", screensDrive, { passive: true });
    window.addEventListener("resize", screensRelayout);

    /* The runway is derived from the strip's scroll width, which is not final
       at parse time: images and web fonts both change it after the fact. A
       stale, too-short runway maps the whole filmstrip onto a few hundred
       pixels of page scroll and the gallery flies past. Safari in Lockdown
       Mode blocks custom fonts, so it lands on a different layout than the
       one measured here — remeasure whenever the strip actually changes. */
    window.addEventListener("load", screensRelayout);
    document.fonts?.ready.then(screensRelayout);
    for (const img of screensStrip.querySelectorAll("img")) {
      if (!img.complete) img.addEventListener("load", screensRelayout, { once: true });
    }
    if ("ResizeObserver" in window) {
      new ResizeObserver(screensRelayout).observe(screensStrip);
    }
    screensMq.addEventListener("change", () => {
      screensLayout();
      screensDrive();
    });

    // Tap a slide for a full-screen view. A scroll gesture never fires
    // click, so swiping the strip won't open it by accident. Inside, swipe,
    // arrow keys, or the ‹ › buttons move between screenshots.
    const lightbox = screensSec.querySelector<HTMLDialogElement>(".screens-lightbox");
    const lightboxImg = lightbox?.querySelector("img");
    const slides = [...screensStrip.querySelectorAll<HTMLImageElement>(".shot-frame img")];
    if (lightbox && lightboxImg && slides.length) {
      let current = 0;

      const show = (i: number) => {
        current = (i + slides.length) % slides.length;
        lightboxImg.src = slides[current].src;
        lightboxImg.alt = slides[current].alt;
      };

      screensStrip.addEventListener("click", (e) => {
        const img = (e.target as HTMLElement).closest(".shot-frame")?.querySelector("img");
        if (!img) return;
        show(slides.indexOf(img as HTMLImageElement));
        lightbox.showModal();
      });

      lightbox.querySelector(".lightbox-nav--prev")?.addEventListener("click", () => show(current - 1));
      lightbox.querySelector(".lightbox-nav--next")?.addEventListener("click", () => show(current + 1));

      lightbox.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") show(current - 1);
        if (e.key === "ArrowRight") show(current + 1);
      });

      // Swipe to navigate; a swipe must not fall through to the tap-to-close
      // click that follows it.
      let touchX = 0;
      let swiped = false;
      lightbox.addEventListener("pointerdown", (e) => {
        touchX = e.clientX;
        swiped = false;
      });
      lightbox.addEventListener("pointerup", (e) => {
        const dx = e.clientX - touchX;
        if (Math.abs(dx) > 40) {
          swiped = true;
          show(dx < 0 ? current + 1 : current - 1);
        }
      });

      lightbox.addEventListener("click", (e) => {
        if (swiped) {
          swiped = false;
          return;
        }
        const t = e.target as HTMLElement;
        // Close on ✕ or on any tap that isn't the image or a nav button.
        if (t.closest(".lightbox-close") || !t.closest("img, .lightbox-nav")) lightbox.close();
      });
    }
  }
</script>

<script>
  // Ambient network between the floating hero cards: pulses fire between
  // random card pairs, in random directions, on random timing. Lines exist
  // only while a transfer is in flight; the receiving card glows briefly.
  const NS = "http://www.w3.org/2000/svg";
  const LINE_INTENSITY = 1.15;

  const COLOR: Record<string, string> = {
    "hf-bitcoin": "#f7931a",
    "hf-lightning": "#8b5cf6",
    "hf-opencode": "#9ca3af",
    "hf-liquid": "#22e1c9",
    "hf-btcpay": "#51b13e",
  };

  let uid = 0;

  function el(tag: string, attrs: Record<string, string>) {
    const node = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
    return node;
  }

  function center(mark: Element, origin: DOMRect) {
    const r = mark.getBoundingClientRect();
    return { x: r.left - origin.left + r.width / 2, y: r.top - origin.top + r.height / 2 };
  }

  function colorOf(mark: Element) {
    const cls = [...mark.classList].find((c) => c.startsWith("hf-"));
    return (cls && COLOR[cls]) || "#9ca3af";
  }

  function glow(mark: Element, ms: number) {
    mark.animate(
      [{ filter: "brightness(1)" }, { filter: "brightness(1.25)" }, { filter: "brightness(1)" }],
      { duration: ms, easing: "ease-in-out" },
    );
  }

  function visibleMarks(hero: HTMLElement) {
    return [...hero.querySelectorAll(".hero-float-mark")].filter(
      (m) => getComputedStyle(m).display !== "none",
    );
  }

  // Value moves between the real Bitcoin connections. OpenCode is the
  // observer — it only ever polls them (see report/query below).
  function fire(hero: HTMLElement, svg: SVGSVGElement) {
    const marks = visibleMarks(hero).filter((m) => !m.classList.contains("hf-opencode"));
    if (marks.length < 2) return;

    const i = Math.floor(Math.random() * marks.length);
    let j = Math.floor(Math.random() * (marks.length - 1));
    if (j >= i) j++;
    transfer(hero, svg, marks[i], marks[j]);
  }

  // OpenCode is an LLM agent: it polls one or two connections per round.
  // Outbound query only — a dashed line marches out to the card and the card
  // glows in acknowledgment. Nothing that looks like value flows back in.
  function report(hero: HTMLElement, svg: SVGSVGElement) {
    const oc = hero.querySelector<HTMLElement>(".hf-opencode");
    if (!oc || getComputedStyle(oc).display === "none") return;
    const others = visibleMarks(hero)
      .filter((m) => m !== oc)
      .sort(() => Math.random() - 0.5);
    const n = Math.random() < 0.4 ? 2 : 1;
    others.slice(0, n).forEach((m, k) => setTimeout(() => query(hero, svg, oc, m), k * 2000));
  }

  function query(hero: HTMLElement, svg: SVGSVGElement, oc: Element, target: Element) {
    const origin = hero.getBoundingClientRect();
    const p1 = center(oc, origin);
    const p2 = center(target, origin);
    const bow = (0.06 + Math.random() * 0.1) * (Math.random() < 0.5 ? -1 : 1);
    const d = `M ${p1.x} ${p1.y} Q ${(p1.x + p2.x) / 2 - (p2.y - p1.y) * bow} ${(p1.y + p2.y) / 2 + (p2.x - p1.x) * bow} ${p2.x} ${p2.y}`;

    const c = colorOf(target);
    const ask = el("path", { class: "hl-ask", d, stroke: c, style: `--glow: ${c}` });
    svg.appendChild(ask);
    const askDur = 700;
    ask.animate(
      [
        { opacity: 0, strokeDashoffset: 44 },
        { opacity: 0.5 * LINE_INTENSITY, strokeDashoffset: 22, offset: 0.3 },
        { opacity: 0.23 * LINE_INTENSITY, strokeDashoffset: 0, offset: 0.7 },
        { opacity: 0, strokeDashoffset: -12 },
      ],
      { duration: askDur + 600, easing: "linear" },
    );
    setTimeout(() => glow(target, 900), askDur * 0.7);
    setTimeout(() => ask.remove(), askDur + 700);
  }

  const dispose = (ms: number, ...nodes: Element[]) =>
    setTimeout(() => nodes.forEach((n) => n.remove()), ms);

  type Pt = { x: number; y: number };

  // ── Lightning pathfinding ─────────────────────────────────────
  // An LN payment isn't a straight wire: the sender builds candidate routes
  // through relay nodes, probes one, gets the failure error back from the
  // hop that rejected it, retries another route, and only then commits.
  // The bright bolt is the route that worked; the settle pulse runs
  // backward, like the preimage returning to the sender.
  function lightningTransfer(hero: HTMLElement, svg: SVGSVGElement, a: Element, b: Element) {
    const origin = hero.getBoundingClientRect();
    const p1 = center(a, origin);
    const p2 = center(b, origin);
    const dx = p2.x - p1.x;
    const dy = p2.y - p1.y;
    const dist = Math.hypot(dx, dy);
    const ca = colorOf(a);
    const cb = colorOf(b);
    const FAIL = "#f87171";

    // Ephemeral relay nodes scattered in the corridor between the cards.
    const relays: Pt[] = Array.from({ length: 4 + Math.floor(Math.random() * 2) }, () => {
      const t = 0.18 + Math.random() * 0.64;
      const off = (Math.random() - 0.5) * dist * 0.32;
      return { x: p1.x + dx * t - (dy / dist) * off, y: p1.y + dy * t + (dx / dist) * off };
    });

    // A route: sender → 1–3 relays ordered by progress toward the receiver.
    const route = (): Pt[] => {
      const picks = [...relays]
        .sort(() => Math.random() - 0.5)
        .slice(0, 1 + Math.floor(Math.random() * 2))
        .sort(
          (m, n) =>
            (m.x - p1.x) * dx + (m.y - p1.y) * dy - ((n.x - p1.x) * dx + (n.y - p1.y) * dy),
        );
      return [p1, ...picks, p2];
    };

    // Jagged discharge path through the route's hops.
    const boltD = (hops: Pt[]) => {
      const pts: Pt[] = [hops[0]];
      for (let h = 1; h < hops.length; h++) {
        const A = hops[h - 1];
        const B = hops[h];
        const hd = Math.hypot(B.x - A.x, B.y - A.y);
        const segs = Math.max(2, Math.round(hd / 70));
        for (let s = 1; s < segs; s++) {
          const t = s / segs;
          const off = (Math.random() - 0.5) * 8;
          pts.push({
            x: A.x + (B.x - A.x) * t - ((B.y - A.y) / hd) * off,
            y: A.y + (B.y - A.y) * t + ((B.x - A.x) / hd) * off,
          });
        }
        pts.push(B);
      }
      return "M " + pts.map((p) => `${p.x} ${p.y}`).join(" L ");
    };

    // A probe marches out dashed, dies at the failing hop with a red blip,
    // and the error marches back to the sender tinted red.
    const probeDur = 1050;
    const probeFail = (r: Pt[]) => {
      const failHop = 1 + Math.floor(Math.random() * (r.length - 2));
      const tried = r.slice(0, failHop + 1);
      const p = el("path", { class: "hl-ask", d: boltD(tried), stroke: cb, "stroke-width": "1.3", style: `--glow: ${cb}` });
      svg.appendChild(p);
      p.animate(
        [
          { opacity: 0, strokeDashoffset: 90, stroke: cb },
          { opacity: 0.4 * LINE_INTENSITY, strokeDashoffset: 30, stroke: cb, offset: 0.4 },
          { opacity: 0.34 * LINE_INTENSITY, strokeDashoffset: 0, stroke: cb, offset: 0.55 },
          { opacity: 0.38 * LINE_INTENSITY, strokeDashoffset: 55, stroke: FAIL, offset: 0.85 },
          { opacity: 0, strokeDashoffset: 90, stroke: FAIL },
        ],
        { duration: probeDur, easing: "linear" },
      );
      const failAt = tried[tried.length - 1];
      const x = el("circle", {
        class: "hl-dot", r: "3.5",
        cx: String(failAt.x), cy: String(failAt.y),
        fill: FAIL, style: `--glow: ${FAIL}`,
      });
      setTimeout(() => {
        svg.appendChild(x);
        x.animate([{ opacity: 0 }, { opacity: 0.7 }, { opacity: 0 }], { duration: 320 });
        dispose(340, x);
      }, probeDur * 0.5);
      dispose(probeDur + 40, p);
    };

    // The route that worked: full bolt, payment dot forward, hops flashing
    // as the HTLCs lock in, then a bright settle pulse back to the sender.
    const commit = (r: Pt[]) => {
      const d = boltD(r);
      const id = `hl-${uid++}`;
      const grad = el("linearGradient", {
        id,
        gradientUnits: "userSpaceOnUse",
        x1: String(p1.x), y1: String(p1.y), x2: String(p2.x), y2: String(p2.y),
      });
      grad.appendChild(el("stop", { offset: "0", "stop-color": ca }));
      grad.appendChild(el("stop", { offset: "1", "stop-color": cb }));
      svg.appendChild(grad);

      const dur = 700 + Math.random() * 300;
      const base = el("path", { class: "hl-line", d, stroke: `url(#${id})`, "stroke-width": "1.8", style: `--glow: ${cb}` });
      svg.appendChild(base);
      base.animate(
        [
          { opacity: 0 },
          { opacity: 0.52 * LINE_INTENSITY, offset: 0.06 },
          { opacity: 0.11 * LINE_INTENSITY, offset: 0.14 },
          { opacity: 0.42 * LINE_INTENSITY, offset: 0.24 },
          { opacity: 0.28 * LINE_INTENSITY, offset: 0.6 },
          { opacity: 0 },
        ],
        { duration: dur + 650, easing: "linear" },
      );

      // Relay hops flash as the payment locks in through them.
      r.slice(1, -1).forEach((hop, i) => {
        setTimeout(() => {
          const f = el("circle", {
            class: "hl-dot", r: "3",
            cx: String(hop.x), cy: String(hop.y),
            fill: cb, style: `--glow: ${cb}`,
          });
          svg.appendChild(f);
          f.animate([{ opacity: 0 }, { opacity: 0.65 }, { opacity: 0 }], { duration: 380 });
          dispose(400, f);
        }, (dur * (i + 1)) / (r.length - 1));
      });

      // Delivery and settlement read from the glows alone: receiver first,
      // then the sender as the preimage makes it back.
      setTimeout(() => glow(b, 700), dur);
      setTimeout(() => glow(a, 500), dur + 340);
      dispose(dur + 700, grad, base);
    };

    // The mesh fades in while the sender is pathfinding, out once settled.
    const attempts = 1 + (Math.random() < 0.25 ? 1 : 0);
    const commitAt = attempts * (probeDur + 300);
    const meshLife = commitAt + 1700;
    relays.forEach((rl) => {
      const m = el("circle", {
        class: "hl-dot", r: "1.8",
        cx: String(rl.x), cy: String(rl.y),
        fill: cb, style: `--glow: ${cb}`,
      });
      svg.appendChild(m);
      m.animate(
        [
          { opacity: 0 },
          { opacity: 0.26, offset: 150 / meshLife },
          { opacity: 0.26, offset: 1 - 400 / meshLife },
          { opacity: 0 },
        ],
        { duration: meshLife, easing: "linear" },
      );
      dispose(meshLife + 40, m);
    });

    glow(a, 600);
    for (let n = 0; n < attempts; n++) {
      setTimeout(() => probeFail(route()), n * (probeDur + 300));
    }
    setTimeout(() => commit(route()), commitAt);
  }

  function transfer(hero: HTMLElement, svg: SVGSVGElement, a: Element, b: Element) {
    if (a.classList.contains("hf-lightning") || b.classList.contains("hf-lightning"))
      return lightningTransfer(hero, svg, a, b);

    const origin = hero.getBoundingClientRect();
    const p1 = center(a, origin);
    const p2 = center(b, origin);
    const dx = p2.x - p1.x;
    const dy = p2.y - p1.y;
    const bow = (0.08 + Math.random() * 0.22) * (Math.random() < 0.5 ? -1 : 1);
    const d = `M ${p1.x} ${p1.y} Q ${(p1.x + p2.x) / 2 - dy * bow} ${(p1.y + p2.y) / 2 + dx * bow} ${p2.x} ${p2.y}`;

    const ca = colorOf(a);
    const cb = colorOf(b);
    const id = `hl-${uid++}`;
    const grad = el("linearGradient", {
      id,
      gradientUnits: "userSpaceOnUse",
      x1: String(p1.x), y1: String(p1.y), x2: String(p2.x), y2: String(p2.y),
    });
    grad.appendChild(el("stop", { offset: "0", "stop-color": ca }));
    grad.appendChild(el("stop", { offset: "1", "stop-color": cb }));
    svg.appendChild(grad);

    const dur = 1500 + Math.random() * 900;

    // Faint context line that snaps in and decays slowly like an afterglow.
    const base = el("path", { class: "hl-line", d, stroke: `url(#${id})`, style: `--glow: ${cb}` });
    svg.appendChild(base);
    base.animate(
      [
        { opacity: 0 },
        { opacity: 0.44 * LINE_INTENSITY, offset: 0.12 },
        { opacity: 0.31 * LINE_INTENSITY, offset: 0.55 },
        { opacity: 0 },
      ],
      { duration: dur + 400, easing: "linear" },
    );

    glow(a, 700);
    setTimeout(() => glow(b, 700), dur);
    dispose(dur + 400, grad, base);
  }

  // On narrow screens the cards frame the text, so every line would cut
  // straight through the copy — no network there, the cards just float.
  const wideEnough = window.matchMedia("(min-width: 768px)");
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>(".hero").forEach((hero) => {
      const svg = hero.querySelector<SVGSVGElement>(".hero-links");
      if (!svg) return;
      // Fire only while the hero is on screen.
      let visible = false;
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
      }).observe(hero);
      const tick = () => {
        // Roughly every fifth event is an OpenCode poll round.
        if (visible && wideEnough.matches) (Math.random() < 0.2 ? report : fire)(hero, svg);
        setTimeout(tick, 1100 + Math.random() * 2000);
      };
      setTimeout(tick, Math.random() * 1200);
    });
  }
</script>

