---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 · Kassiber"
  description="No route found. The page you are looking for may have moved — or never existed."
>
  <section class="nf">
    <div class="nf-inner">
      <svg class="nf-net" viewBox="0 0 360 120" aria-hidden="true">
        <circle class="nf-sender" cx="24" cy="60" r="5"></circle>
        <circle class="nf-target" cx="336" cy="60" r="5"></circle>
      </svg>
      <h1><span class="nf-code">404</span> No route found.</h1>
      <p class="nf-lede">
        Every path we probed came back with an error. The page you are looking
        for may have moved — or never existed.
      </p>
      <div class="nf-actions">
        <a class="nf-home" href="/">Back to the homepage</a>
        <a class="nf-alt" href="/download">Download Kassiber</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // The homepage hero's pathfinding vignette, condensed to its failure mode:
  // probes march out through relay nodes, die with a red blip, and the error
  // returns to the sender. No route ever commits — that's the joke.
  const NS = "http://www.w3.org/2000/svg";
  const PURPLE = "#8b5cf6";
  const FAIL = "#f87171";

  const svg = document.querySelector<SVGSVGElement>(".nf-net");
  if (svg && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const el = (tag: string, attrs: Record<string, string>) => {
      const node = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
      return node;
    };
    const dispose = (ms: number, ...nodes: Element[]) =>
      setTimeout(() => nodes.forEach((n) => n.remove()), ms);

    const p1 = { x: 24, y: 60 };

    // Static relay mesh, faint and always there.
    const relays = Array.from({ length: 4 }, (_, i) => ({
      x: 80 + i * 60 + Math.random() * 30,
      y: 24 + Math.random() * 72,
    }));
    relays.forEach((r) => {
      const m = el("circle", { class: "nf-relay", cx: String(r.x), cy: String(r.y), r: "2" });
      svg.appendChild(m);
    });

    const boltD = (hops: { x: number; y: number }[]) => {
      const pts = [hops[0]];
      for (let h = 1; h < hops.length; h++) {
        const A = hops[h - 1];
        const B = hops[h];
        const hd = Math.hypot(B.x - A.x, B.y - A.y);
        const segs = Math.max(2, Math.round(hd / 50));
        for (let s = 1; s < segs; s++) {
          const t = s / segs;
          const off = (Math.random() - 0.5) * 7;
          pts.push({
            x: A.x + (B.x - A.x) * t - ((B.y - A.y) / hd) * off,
            y: A.y + (B.y - A.y) * t + ((B.x - A.x) / hd) * off,
          });
        }
        pts.push(B);
      }
      return "M " + pts.map((p) => `${p.x} ${p.y}`).join(" L ");
    };

    const probe = () => {
      // A candidate route through 1–2 relays, ordered left to right —
      // it always dies at the last relay, one hop short of the page.
      const picks = [...relays]
        .sort(() => Math.random() - 0.5)
        .slice(0, 1 + Math.floor(Math.random() * 2))
        .sort((m, n) => m.x - n.x);
      const tried = [p1, ...picks];
      const failAt = tried[tried.length - 1];

      const dur = 1300;
      const path = el("path", { class: "nf-probe", d: boltD(tried), stroke: PURPLE });
      svg.appendChild(path);
      path.animate(
        [
          { opacity: 0, strokeDashoffset: 90, stroke: PURPLE },
          { opacity: 0.85, strokeDashoffset: 30, stroke: PURPLE, offset: 0.4 },
          { opacity: 0.7, strokeDashoffset: 0, stroke: PURPLE, offset: 0.55 },
          { opacity: 0.7, strokeDashoffset: 55, stroke: FAIL, offset: 0.85 },
          { opacity: 0, strokeDashoffset: 90, stroke: FAIL },
        ],
        { duration: dur, easing: "linear" },
      );
      setTimeout(() => {
        const x = el("circle", {
          class: "nf-blip", r: "3.5",
          cx: String(failAt.x), cy: String(failAt.y), fill: FAIL,
        });
        svg.appendChild(x);
        x.animate([{ opacity: 0 }, { opacity: 1 }, { opacity: 0 }], { duration: 380 });
        dispose(400, x);
      }, dur * 0.5);
      dispose(dur + 40, path);

      setTimeout(probe, dur + 600 + Math.random() * 900);
    };
    setTimeout(probe, 600);
  }
</script>

<style>
  .nf {
    display: grid;
    place-items: center;
    min-height: calc(100vh - 220px);
    padding: 120px 24px 80px;
  }

  .nf-inner {
    max-width: 560px;
    text-align: center;
  }

  .nf-net {
    width: min(360px, 100%);
    height: auto;
    margin: 0 auto 8px;
    overflow: visible;
  }

  .nf-sender {
    fill: #f7931a;
    filter: drop-shadow(0 0 5px rgba(247, 147, 26, 0.6));
  }

  .nf-target {
    fill: none;
    stroke: rgba(255, 255, 255, 0.25);
    stroke-width: 1.5;
    stroke-dasharray: 3 3;
  }

  .nf-net :global(.nf-relay) {
    fill: #8b5cf6;
    opacity: 0.45;
  }

  .nf-net :global(.nf-probe) {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 5 8;
    opacity: 0;
    filter: drop-shadow(0 0 6px #8b5cf6);
  }

  .nf-net :global(.nf-blip) {
    opacity: 0;
    filter: drop-shadow(0 0 6px #f87171);
  }

  .nf-code {
    font-family: "JetBrains Mono", monospace;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.45);
    margin-right: 0.15em;
  }

  h1 {
    font-size: clamp(32px, 6vw, 48px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .nf-lede {
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    margin: 0 0 32px;
  }

  .nf-actions {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .nf-home {
    background: #fff;
    color: #09090b;
    border-radius: 10px;
    padding: 11px 20px;
    font-weight: 500;
    font-size: 14.5px;
    text-decoration: none;
  }

  .nf-home:hover {
    background: rgba(255, 255, 255, 0.88);
  }

  .nf-alt {
    color: rgba(255, 255, 255, 0.65);
    font-size: 14.5px;
    text-decoration: none;
  }

  .nf-alt:hover {
    color: #fff;
  }
</style>
